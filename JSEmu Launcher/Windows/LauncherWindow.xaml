<Window x:Class="H1Emu_Launcher.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:f="clr-namespace:H1Emu_Launcher.Classes"
        xmlns:local="clr-namespace:H1Emu_Launcher"
        mc:Ignorable="d" UseLayoutRounding="True" Title="JSEmu Launcher"
        x:Name="Launcher" Width="1280" Height="720" MinWidth="1100" MinHeight="619"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        FontFamily="Segoe UI" FontSize="15" Foreground="#E7E9ED" Background="Transparent"
        Loaded="LauncherWindowLoaded" ContentRendered="LauncherWindowContentRendered"
        IsVisibleChanged="LauncherWindowIsVisibleChanged" Closed="LauncherWindowClosed">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="1" CaptionHeight="0" NonClientFrameEdges="Bottom, Left, Right"/>
    </WindowChrome.WindowChrome>

    <!-- Layout (1440 x 810, scaled by the Viewbox):
         top bar        power mark, 2016 / 2018 switch, wordmark, Discord, window controls
         left column    hero (logo, edition, description), Hub / Dressing Room tiles, game card with Play
         right column   updates card (patch notes + screenshots), Steam download card
         footer         server status, jsemu.eu, launcher version
         Every accent colour comes from the Accent.* brushes of Classes/EditionTheme.cs: red for 2016,
         ember for 2018, animated when the edition changes. Styles sit directly in Window.Resources
         because the language switch replaces the merged dictionaries. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Language\StringResources.en-EN.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Storyboard x:Key="CarouselNextImageAnimation" Completed="StoryboardCompleted">
                <DoubleAnimation Storyboard.TargetName="carouselImageTranslate" Storyboard.TargetProperty="(TranslateTransform.X)" From="0" To="-496" Duration="0:0:0.65"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            </Storyboard>
            <Storyboard x:Key="CarouselNextImageAnimationFollow" Completed="StoryboardCompleted">
                <DoubleAnimation Storyboard.TargetName="carouselImageFollowTranslate" Storyboard.TargetProperty="(TranslateTransform.X)" From="496" To="0" Duration="0:0:0.65"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            </Storyboard>
            <Storyboard x:Key="CarouselPrevImageAnimation" Completed="StoryboardCompleted">
                <DoubleAnimation Storyboard.TargetName="carouselImageTranslate" Storyboard.TargetProperty="(TranslateTransform.X)" From="0" To="496" Duration="0:0:0.65"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            </Storyboard>
            <Storyboard x:Key="CarouselPrevImageAnimationFollow" Completed="StoryboardCompleted">
                <DoubleAnimation Storyboard.TargetName="carouselImageFollowTranslate" Storyboard.TargetProperty="(TranslateTransform.X)" From="-496" To="0" Duration="0:0:0.65"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            </Storyboard>

            <SolidColorBrush x:Key="L.Card" Color="#E60C0E11"/>
            <SolidColorBrush x:Key="L.CardBorder" Color="#2A2E33"/>
            <SolidColorBrush x:Key="L.Field" Color="#D90F1216"/>
            <SolidColorBrush x:Key="L.Text" Color="#EEEFF1"/>
            <SolidColorBrush x:Key="L.Muted" Color="#8B9198"/>
            <SolidColorBrush x:Key="L.Dim" Color="#5D636A"/>
            <SolidColorBrush x:Key="L.Online" Color="#52B84A"/>

            <!-- Glass card with a thin accent line on top -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource L.Card}"/>
                <Setter Property="BorderBrush" Value="{StaticResource L.CardBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
            </Style>
            <Style x:Key="CardHeading" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Signika}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource L.Muted}"/>
            </Style>

            <Style x:Key="ChromeButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#E8E8E8"/><Setter Property="Background" Value="#D80A0D11"/>
                <Setter Property="BorderBrush" Value="#2A3035"/><Setter Property="BorderThickness" Value="1,0,0,0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="ChromeBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChromeBorder" Property="Background" Value="#252A30"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ChromeBorder" Property="Opacity" Value="0.68"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>

            <!-- Edition tab (2016 / 2018): the sliding accent pill behind the tabs marks the active one. -->
            <Style x:Key="EditionTabStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#9A9FA6"/><Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="HoverLayer" Background="#14FFFFFF" CornerRadius="7" Opacity="0" IsHitTestVisible="False"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverLayer" Property="Opacity" Value="1"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="HoverLayer" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>

            <!-- Plain dark button, accent edge on hover -->
            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource L.Text}"/>
                <Setter Property="Background" Value="#E6131619"/>
                <Setter Property="BorderBrush" Value="{StaticResource L.CardBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="{StaticResource Signika}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Edge" BorderBrush="{DynamicResource Accent.Brush}" BorderThickness="1" CornerRadius="5" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>

            <!-- Quick-action tile (Hub, Dressing Room): Uid = title, Tag = subtitle, content = icon -->
            <Style x:Key="TileButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource L.Text}"/>
                <Setter Property="Background" Value="{StaticResource L.Card}"/>
                <Setter Property="BorderBrush" Value="{StaticResource L.CardBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Grid>
                        <Grid.RenderTransform><TranslateTransform x:Name="Lift"/></Grid.RenderTransform>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Uid, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource Signika}" FontWeight="SemiBold" FontSize="15" Foreground="#F5F6F7"/>
                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{StaticResource L.Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Path Grid.Column="2" Data="{DynamicResource RightArrowIcon}" Fill="{DynamicResource Accent.Brush}" Width="6" Height="12" Stretch="Fill" HorizontalAlignment="Right">
                                    <Path.RenderTransform><TranslateTransform x:Name="ArrowShift"/></Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>
                        <Border x:Name="Edge" BorderBrush="{DynamicResource Accent.Brush}" BorderThickness="1" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="ArrowShift" Storyboard.TargetProperty="X" To="3" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.15"/>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetName="ArrowShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2"/>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>

            <!-- Accent link. No colour animation: the accent brushes are frozen resources, so hover uses plain setters. -->
            <Style x:Key="AccentLink" TargetType="Hyperlink">
                <Setter Property="Foreground" Value="{DynamicResource Accent.LightBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#F2F3F5"/></Trigger>
                </Style.Triggers>
            </Style>

            <!-- The big Play button: accent gradient, glow handled by the layer behind it -->
            <Style x:Key="PlayButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource Accent.TextOnBrush}"/>
                <Setter Property="Background" Value="{DynamicResource Accent.GradientBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent.LightBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="{StaticResource Signika}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
                        <Border x:Name="Shine" CornerRadius="6" IsHitTestVisible="False">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#30FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.5"/>
                            </LinearGradientBrush></Border.Background>
                        </Border>
                        <Border x:Name="Hover" CornerRadius="6" Background="#22FFFFFF" Opacity="0" IsHitTestVisible="False"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.82"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#24272B"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#383C42"/>
                            <Setter TargetName="Shine" Property="Opacity" Value="0.3"/>
                            <Setter Property="Foreground" Value="#8A9097"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.TaskbarItemInfo><TaskbarItemInfo x:Name="taskbarIcon" Description="JSEmu Launcher"/></Window.TaskbarItemInfo>

    <Viewbox Stretch="Uniform">
    <Border Width="1440" Height="810" Background="#08090B" BorderBrush="#252B30" BorderThickness="1" CornerRadius="15" ClipToBounds="True"
            MouseLeftButtonDown="MoveWindow">
        <Grid>
            <!-- Backdrops: one per edition, cross-faded on the switch -->
            <Image x:Name="backdrop2016" Source="..\Resources\Backdrop2016.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
            <Image x:Name="backdrop2018" Source="..\Resources\Backdrop2018.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" Opacity="0"/>
            <!-- edition-coloured ambient light behind the hero -->
            <Ellipse Width="1100" Height="760" Margin="-380,-360,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource Accent.GlowBrush}" Opacity="0.45" IsHitTestVisible="False"/>
            <Rectangle IsHitTestVisible="False" Opacity="0.06">
                <Rectangle.Fill><ImageBrush ImageSource="..\Resources\Grain.png" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,512,512"/></Rectangle.Fill>
            </Rectangle>

            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>

                <!-- ============ top bar ============ -->
                <Grid Grid.Row="0">
                    <Border Width="38" Height="38" Margin="18,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#CA090C10" BorderBrush="#3B4146" BorderThickness="1" CornerRadius="9">
                        <Grid><Ellipse Width="13" Height="13" Stroke="#DDE1E5" StrokeThickness="1.5"/><Rectangle Width="3" Height="8" Fill="{DynamicResource Accent.Brush}" RadiusX="1" RadiusY="1"/></Grid>
                    </Border>

                    <!-- Game edition switch: 2016 (classic JSEmu servers) / 2018 (Steam build, JSEmu 2018 server) -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Center" Margin="66,0,0,0" Background="#E6070A0D" BorderBrush="#2C3237" BorderThickness="1" CornerRadius="10" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="GAME" Foreground="#6E757C" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,8,0">
                                <TextBlock.LayoutTransform><RotateTransform Angle="-90"/></TextBlock.LayoutTransform>
                            </TextBlock>
                            <Grid>
                                <Border x:Name="editionIndicator" Width="104" HorizontalAlignment="Left" CornerRadius="7" Background="{DynamicResource Accent.GradientBrush}" BorderBrush="{DynamicResource Accent.LightBrush}" BorderThickness="1">
                                    <Border.RenderTransform><TranslateTransform x:Name="editionIndicatorShift"/></Border.RenderTransform>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="edition2016Button" Tag="2016" Click="EditionButtonClick" Height="44" Width="104" Style="{StaticResource EditionTabStyle}" ToolTip="Just Survive 2016 - classic JSEmu servers">
                                        <StackPanel>
                                            <TextBlock Text="2016" FontFamily="{StaticResource Signika}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="edition2016Sub" Text="CLASSIC" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Opacity="0.8"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="edition2018Button" Tag="2018" Click="EditionButtonClick" Height="44" Width="104" Style="{StaticResource EditionTabStyle}" ToolTip="Just Survive 2018 - Steam build, JSEmu 2018 server">
                                        <StackPanel>
                                            <TextBlock Text="2018" FontFamily="{StaticResource Signika}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="edition2018Sub" Text="STEAM" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Opacity="0.8"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- centre wordmark -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Rectangle Width="20" Height="18" Fill="{DynamicResource Accent.Brush}" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Rectangle.OpacityMask><ImageBrush ImageSource="..\Resources\LogoMark.png" Stretch="Uniform" Viewbox="0,0,0.17,1"/></Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock FontFamily="{StaticResource Signika}" FontSize="15" FontWeight="SemiBold" Foreground="#C9CCD0" VerticalAlignment="Center"><Run Text="J S E M U   ·   "/><Run x:Name="topEditionText" Text="2 0 1 6" Foreground="{DynamicResource Accent.LightBrush}"/></TextBlock>
                    </StackPanel>

                    <Button x:Name="discordLink" Click="OpenDiscord" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,244,0" Height="42" Padding="16,0" Style="{StaticResource GhostButton}" ToolTip="Join the JSEmu Discord">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M3,6 C5,2.5 19,2.5 21,6 L23,13 C23.8,15.8 20,17.5 18,14.7 L16.5,12.8 C13.5,13.8 10.5,13.8 7.5,12.8 L6,14.7 C4,17.5 0.2,15.8 1,13 Z" Fill="#8C95FF" Width="20" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="JOIN DISCORD" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.ContextMenu><ContextMenu Style="{DynamicResource ContextMenuStyle}"><MenuItem x:Name="discordLinkCopyMenuItem" Click="DiscordLinkCopyClick" Header="{DynamicResource item193}" Style="{DynamicResource CustomMenuItem}"/></ContextMenu></Button.ContextMenu>
                    </Button>

                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" Background="#DC070A0D" BorderBrush="#2C3237" BorderThickness="1" CornerRadius="7">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SettingsButton" Width="50" Height="42" Click="SettingsButtonClick" Style="{StaticResource ChromeButtonStyle}" BorderThickness="0" ToolTip="Settings">
                                <Path x:Name="settingsButtonIcon" Data="{DynamicResource SettingsIcon}" Width="17" Height="17" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"><Path.RenderTransform><RotateTransform x:Name="rotateSettingsIcon"/></Path.RenderTransform></Path>
                            </Button>
                            <Button x:Name="MinimiseToSystemTrayButton" Width="50" Height="42" Click="MinimiseToSystemTrayButtonClick" Style="{StaticResource ChromeButtonStyle}" ToolTip="Minimize to tray">
                                <Path Data="{DynamicResource MinimiseToSystemTrayIcon}" Width="13" Height="13" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button x:Name="MinimiseButton" Width="50" Height="42" Click="MinimiseButtonClick" Style="{StaticResource ChromeButtonStyle}" ToolTip="Minimize">
                                <Path Data="{DynamicResource MinimiseIcon}" Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button>
                            <Button x:Name="ExitButton" Width="54" Height="42" Click="CloseLauncher" Background="#8E0000" BorderBrush="#B3181D" Style="{StaticResource ChromeButtonStyle}" ToolTip="Close">
                                <Path Data="{DynamicResource XIcon}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Rectangle Height="1" VerticalAlignment="Bottom" Margin="40,0" Fill="{DynamicResource Accent.LineBrush}" Opacity="0.7" IsHitTestVisible="False"/>
                </Grid>

                <!-- ============ body ============ -->
                <Grid Grid.Row="1" Margin="56,20,32,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="540"/></Grid.ColumnDefinitions>

                    <!-- left: hero, quick actions, game card -->
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                        <StackPanel x:Name="heroPanel" VerticalAlignment="Top" Margin="0,14,0,0">
                            <StackPanel.RenderTransform><TranslateTransform x:Name="heroShift"/></StackPanel.RenderTransform>
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,16">
                                <Border Width="4" Height="16" Background="{DynamicResource Accent.Brush}" CornerRadius="1" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock x:Name="heroKicker" Text="SURVIVAL   ·   JSEMU SERVERS   ·   EU" FontFamily="{StaticResource Signika}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Accent.LightBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- JSEmu logo: white wordmark + the slash in the edition accent -->
                            <Grid Height="74" HorizontalAlignment="Left">
                                <Image Source="..\Resources\LogoWordmark.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Rectangle Fill="{DynamicResource Accent.Brush}">
                                    <Rectangle.OpacityMask><ImageBrush ImageSource="..\Resources\LogoMark.png" Stretch="Uniform"/></Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                <Border Background="{DynamicResource Accent.GradientBrush}" CornerRadius="3" Padding="12,3,12,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="heroEdition" Text="JUST SURVIVE 2016" FontFamily="{StaticResource Signika}" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource Accent.TextOnBrush}"/>
                                </Border>
                                <TextBlock x:Name="heroModes" Text="SURVIVAL   ·   PVP   ·   BASE BUILDING" FontFamily="{StaticResource Signika}" FontSize="19" FontWeight="SemiBold" Foreground="#D8DADD" VerticalAlignment="Center" Margin="18,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="heroDescription" Margin="0,16,0,0" MaxWidth="600" HorizontalAlignment="Left" TextWrapping="Wrap" FontSize="15" LineHeight="23" Foreground="#B4B8BD"/>
                        </StackPanel>

                        <!-- quick actions -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                            <Button x:Name="hubButton" Uid="JSEMU HUB" Tag="Battle Pass, Pimp My Car, Scrap Yard" Click="OpenHub" Width="270" Height="66" Style="{StaticResource TileButton}" ToolTip="Battle Pass, Pimp My Car, Scrap Yard and your coins">
                                <Border Width="34" Height="34" Background="#F2BC55" CornerRadius="17">
                                    <TextBlock Text="C" FontSize="17" FontWeight="Bold" Foreground="#3A2A00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Button>
                            <Button x:Name="dressingRoomButton" Uid="DRESSING ROOM" Tag="Change your skins and outfit" Click="OpenDressingRoom" Width="270" Height="66" Margin="14,0,0,0" Style="{StaticResource TileButton}" ToolTip="Change your skins and outfit">
                                <Border Width="34" Height="34" Background="{DynamicResource Accent.GradientBrush}" CornerRadius="9">
                                    <Path Data="M4,7 L9,4 C9.5,6 14.5,6 15,4 L20,7 L18,11 L16,10 L16,20 L8,20 L8,10 L6,11 Z" Fill="{DynamicResource Accent.TextOnBrush}" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Button>
                        </StackPanel>

                        <!-- game card: status, folder, server, Play -->
                        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="24,18,24,22">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Rectangle Height="2" VerticalAlignment="Top" Margin="-24,-19,-24,0" Fill="{DynamicResource Accent.LineBrush}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="GAME STATUS" Style="{StaticResource CardHeading}" Margin="0,0,0,3"/>
                                        <TextBlock x:Name="currentGame" Text="{DynamicResource item69}" FontSize="16" Foreground="{StaticResource L.Text}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Top" Padding="10,4" CornerRadius="3" Background="{DynamicResource Accent.SoftBrush}" BorderBrush="{DynamicResource Accent.BorderBrush}" BorderThickness="1">
                                        <TextBlock x:Name="editionBadge" Text="2016  ·  CLASSIC" FontFamily="{StaticResource Signika}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Accent.LightBrush}"/>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource L.Field}" BorderBrush="{StaticResource L.CardBorder}" BorderThickness="1" CornerRadius="5" Height="44">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button Click="OpenDirectory" Width="44" Height="42" Style="{DynamicResource PathButton}" ToolTip="Open the game folder">
                                                <Path Data="{DynamicResource FolderIcon}" Stroke="{DynamicResource Accent.Brush}" StrokeThickness="1.5" Stretch="Uniform" Width="18" Height="18"/>
                                            </Button>
                                            <TextBlock Grid.Column="1" Text="GAME FOLDER" FontFamily="{StaticResource Signika}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource L.Dim}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBox x:Name="directoryBox" Grid.Column="2" IsReadOnly="True" Text="{DynamicResource item75}" Background="Transparent" BorderThickness="0" Foreground="#D6D9DD" FontSize="14"
                                                     VerticalContentAlignment="Center" Margin="0,0,10,0" Cursor="Arrow" Focusable="False">
                                                <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/></ControlTemplate></TextBox.Template>
                                            </TextBox>
                                        </Grid>
                                    </Border>
                                    <Button x:Name="directoryButton" Grid.Column="1" Content="CHANGE" Click="SelectDirectory" Height="44" Margin="10,0,0,0" Padding="20,0" Style="{StaticResource GhostButton}" ToolTip="Choose the folder of the 2016 game"/>
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
                                    <Grid Height="70">
                                        <ComboBox x:Name="serverSelector" Height="70" Padding="46,0,12,0" SelectedIndex="0" VerticalContentAlignment="Center" FontSize="16" SelectionChanged="ServerSelectorChanged" Background="#11151A" BorderBrush="{DynamicResource Accent.BorderBrush}" BorderThickness="1" Foreground="#E7E9ED" Style="{DynamicResource ComboBoxStyle}">
                                            <ComboBoxItem Content="JSEmu Servers" Style="{DynamicResource ComboBoxItemStyle}"/><ComboBoxItem Content="H1Emu Servers" Style="{DynamicResource ComboBoxItemStyle}"/><ComboBoxItem Content="Singleplayer" Style="{DynamicResource ComboBoxItemStyle}"/><Separator Background="#3A3E43"/><ComboBoxItem Content="New Server..." PreviewMouseLeftButtonUp="AddNewServerClick" Style="{DynamicResource ComboBoxItemStyle}"/>
                                        </ComboBox>
                                        <Path x:Name="serverSelectorIcon" Data="M2,7 L12,2 L22,7 L12,12 Z M2,12 L12,17 L22,12 M2,17 L12,22 L22,17" Stroke="{DynamicResource Accent.LightBrush}" StrokeThickness="1.4" Width="22" Height="22" HorizontalAlignment="Left" Margin="15,0,0,0" IsHitTestVisible="False"/>
                                        <!-- 2018: one fixed server instead of the list -->
                                        <Border x:Name="server2018Info" Visibility="Collapsed" Background="#F20F1216" BorderBrush="{DynamicResource Accent.BorderBrush}" BorderThickness="1" CornerRadius="5">
                                            <Grid Margin="15,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Path Data="M2,7 L12,2 L22,7 L12,12 Z M2,12 L12,17 L22,12 M2,17 L12,22 L22,17" Stroke="{DynamicResource Accent.LightBrush}" StrokeThickness="1.4" Width="22" Height="22" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                                    <TextBlock Text="JSEmu 2018 Server" Foreground="#F2F3F5" FontSize="16" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Just Survive 2018  ·  Steam build 2.1.886508" Foreground="{StaticResource L.Muted}" FontSize="12"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="3" Background="#1A52B84A">
                                                    <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource L.Online}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="EU" Foreground="{StaticResource L.Online}" FontSize="11" FontWeight="Bold"/></StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <!-- soft accent glow behind Play (radial brush, no bitmap effect: those leave specks under the Viewbox) -->
                                    <Border Grid.Column="2" Margin="-34,-30" IsHitTestVisible="False" Background="{DynamicResource Accent.GlowBrush}"/>
                                    <Button x:Name="playButton" Grid.Column="2" Click="LaunchClient" Height="70" Content="{DynamicResource item8}" Style="{StaticResource PlayButtonStyle}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- right: updates and Steam download -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                        <Border Style="{StaticResource CardStyle}" Padding="22,16,22,22">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Rectangle Height="2" VerticalAlignment="Top" Margin="-22,-17,-22,0" Fill="{DynamicResource Accent.LineBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="34" Height="34" Margin="0,0,12,0" Background="{DynamicResource Accent.SoftBrush}" BorderBrush="{DynamicResource Accent.BorderBrush}" BorderThickness="1" CornerRadius="7">
                                        <Path Data="M3,10 L9,10 L15,5 L15,19 L9,14 L3,14 Z M18,8 C20,10 20,14 18,16" Stroke="{DynamicResource Accent.LightBrush}" StrokeThickness="2" Stretch="Uniform" Width="18" Height="18"/>
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource Signika}" FontSize="22" FontWeight="Bold"><Run Text="JSEmu" Foreground="#F0F1F3"/><Run x:Name="updateVersion" Foreground="{DynamicResource Accent.LightBrush}"/><Run x:Name="datePublished" FontSize="13" Foreground="#777E85"/></TextBlock>
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" MaxHeight="76" VerticalScrollBarVisibility="Hidden" Style="{DynamicResource CustomScrollViewer}"><TextBlock x:Name="patchNotesBox" Foreground="#B9BDC2" FontSize="13" LineHeight="19" TextWrapping="Wrap" Style="{DynamicResource TextBlockStyle}"/></ScrollViewer>
                                <TextBlock Grid.Row="2" Margin="0,6,0,12" FontSize="13"><Hyperlink NavigateUri="https://discord.com/channels/1416363907336896544/1425465707339972629" RequestNavigate="FullUpdatesHyperlink" Style="{StaticResource AccentLink}"><Run Text="View updates on Discord   →"/></Hyperlink>
                                    <TextBlock.ContextMenu><ContextMenu Style="{DynamicResource ContextMenuStyle}"><MenuItem Click="PatchNotesCopyClick" Header="{DynamicResource item193}" Style="{DynamicResource CustomMenuItem}"/></ContextMenu></TextBlock.ContextMenu>
                                </TextBlock>
                                <Border Grid.Row="3" Background="#080A0D" CornerRadius="5" ClipToBounds="True"><Grid>
                                    <Image Source="..\Resources\Placeholder.jpg" Stretch="UniformToFill" Opacity="0.52"/>
                                    <Grid x:Name="imageCarousel" ClipToBounds="True" MouseEnter="CarouselMouseEnter" MouseLeave="CarouselMouseLeave">
                                        <Image x:Name="carouselImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"><Image.RenderTransform><TranslateTransform x:Name="carouselImageTranslate"/></Image.RenderTransform></Image>
                                        <Image x:Name="carouselImageFollow" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"><Image.RenderTransform><TranslateTransform x:Name="carouselImageFollowTranslate"/></Image.RenderTransform></Image>
                                        <Border IsHitTestVisible="False" VerticalAlignment="Bottom" Height="60"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#99000000" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                        <Button x:Name="nextImage" Click="NextImageClick" Width="36" Height="56" Opacity="0" HorizontalAlignment="Right" Background="#A0000000" BorderThickness="0" Style="{DynamicResource CarouselButton}"><Path Data="{DynamicResource RightArrowIcon}" Fill="White" Width="8" Height="17"/></Button>
                                        <Button x:Name="prevImage" Click="PrevImageClick" Width="36" Height="56" Opacity="0" HorizontalAlignment="Left" Background="#A0000000" BorderThickness="0" Style="{DynamicResource CarouselButton}"><Path Data="{DynamicResource LeftArrowIcon}" Fill="White" Width="8" Height="17"/></Button>
                                        <Grid x:Name="carouselRectangleGrid" VerticalAlignment="Bottom" Height="4" Margin="10,0,10,10"><Rectangle Fill="#50FFFFFF" RadiusX="2" RadiusY="2"/><Rectangle x:Name="carouselRectangle" Fill="{DynamicResource Accent.Brush}" HorizontalAlignment="Left" RadiusX="2" RadiusY="2"/></Grid>
                                    </Grid>
                                </Grid></Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="22,16,22,18">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Rectangle Height="2" VerticalAlignment="Top" Margin="-22,-17,-22,0" Fill="{DynamicResource Accent.LineBrush}"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="DOWNLOAD THE GAME" Style="{StaticResource CardHeading}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Padding="8,2" CornerRadius="3" Background="#1F66C0F4" BorderBrush="#5566C0F4" BorderThickness="1">
                                        <TextBlock x:Name="steamBadge" Text="STEAM  ·  2016" FontSize="11" FontWeight="Bold" Foreground="#9FD6F7"/>
                                    </Border>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Path Data="{DynamicResource ShieldIcon}" Width="18" Height="20" Stretch="Uniform" Fill="{DynamicResource Accent.Brush}" VerticalAlignment="Top" Margin="0,1,12,0"/>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12" LineHeight="17" Foreground="#A9AEB4"><Run Text="{DynamicResource item10}" Foreground="{DynamicResource Accent.LightBrush}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{DynamicResource item11}"/><Run Text=" "/><Run Text="{DynamicResource item50}" Foreground="#7E848B"/></TextBlock>
                                </Grid>
                                <Frame x:Name="steamFramePanel" Grid.Row="2" Height="140" Source="..\SteamFramePages\Login.xaml" NavigationUIVisibility="Hidden" f:DisableFrameNavigation.Disable="True"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ============ footer ============ -->
                <Grid Grid.Row="2" Margin="56,0,32,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Rectangle Grid.ColumnSpan="3" Height="1" VerticalAlignment="Top" Fill="#1E2226"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="{StaticResource L.Online}" Margin="0,0,10,0"/>
                        <TextBlock x:Name="serverStatusText" Text="JSEMU SERVERS  ·  EU  ·  ONLINE" FontFamily="{StaticResource Signika}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource L.Online}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="OpenWebsite" Cursor="Hand" Style="{DynamicResource PathButton}" ToolTip="jsemu.eu">
                            <TextBlock Text="J S E M U . E U" FontSize="11" FontWeight="SemiBold" Foreground="#9AA0A6"/>
                        </Button>
                        <TextBlock Text="    |    " FontSize="11" Foreground="#3A3F44" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" Foreground="#666C72" FontSize="11" FontWeight="SemiBold"><Run Text="J U S T   S U R V I V E .  "/><Run Text="A G A I N ." Foreground="{DynamicResource Accent.Brush}"/></TextBlock>
                    </StackPanel>
                    <TextBlock x:Name="copyrightNotice" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#666C72" FontSize="12" Text="Launcher Version: 3.5.15" Style="{DynamicResource TextBlockStyle}"/>
                    <TextBlock x:Name="chineseLink" Visibility="Collapsed"><Hyperlink NavigateUri="https://azaz.ge/" RequestNavigate="H1EmuChineseLink"/><TextBlock.ContextMenu><ContextMenu Style="{DynamicResource ContextMenuStyle}"><MenuItem Click="ChineseLinkCopyClick" Header="{DynamicResource item193}" Style="{DynamicResource CustomMenuItem}"/></ContextMenu></TextBlock.ContextMenu></TextBlock>
                </Grid>
            </Grid>
        </Grid>
    </Border>
    </Viewbox>
</Window>
