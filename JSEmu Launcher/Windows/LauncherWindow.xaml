<Window x:Class="H1Emu_Launcher.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:f="clr-namespace:H1Emu_Launcher.Classes"
        mc:Ignorable="d" UseLayoutRounding="True" Title="JSEmu Launcher"
        x:Name="Launcher" Width="1280" Height="720" MinWidth="1100" MinHeight="619"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        FontFamily="Segoe UI" FontSize="15" Foreground="#E7E9ED" Background="Transparent"
        Loaded="LauncherWindowLoaded" ContentRendered="LauncherWindowContentRendered"
        IsVisibleChanged="LauncherWindowIsVisibleChanged" Closing="LauncherWindowClosing" Closed="LauncherWindowClosed">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="1" CaptionHeight="0" NonClientFrameEdges="Bottom, Left, Right"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Language\StringResources.en-EN.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Storyboard x:Key="CarouselNextImageAnimation" Completed="StoryboardCompleted">
                <DoubleAnimation Storyboard.TargetName="carouselImageTranslate" Storyboard.TargetProperty="(TranslateTransform.X)" From="0" To="-570" Duration="0:0:0.65"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            </Storyboard>
            <Storyboard x:Key="CarouselNextImageAnimationFollow" Completed="StoryboardCompleted">
                <DoubleAnimation Storyboard.TargetName="carouselImageFollowTranslate" Storyboard.TargetProperty="(TranslateTransform.X)" From="570" To="0" Duration="0:0:0.65"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            </Storyboard>
            <Storyboard x:Key="CarouselPrevImageAnimation" Completed="StoryboardCompleted">
                <DoubleAnimation Storyboard.TargetName="carouselImageTranslate" Storyboard.TargetProperty="(TranslateTransform.X)" From="0" To="570" Duration="0:0:0.65"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            </Storyboard>
            <Storyboard x:Key="CarouselPrevImageAnimationFollow" Completed="StoryboardCompleted">
                <DoubleAnimation Storyboard.TargetName="carouselImageFollowTranslate" Storyboard.TargetProperty="(TranslateTransform.X)" From="-570" To="0" Duration="0:0:0.65"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            </Storyboard>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="#D90A0E12"/><Setter Property="BorderBrush" Value="#454A50"/>
                <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/>
            </Style>
            <Style x:Key="InnerCardStyle" TargetType="Border">
                <Setter Property="Background" Value="#9E0D1116"/><Setter Property="BorderBrush" Value="#292F35"/>
                <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="11"/>
            </Style>
            <Style x:Key="ChromeButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#E8E8E8"/><Setter Property="Background" Value="#D80A0D11"/>
                <Setter Property="BorderBrush" Value="#2A3035"/><Setter Property="BorderThickness" Value="1,0,0,0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="ChromeBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChromeBorder" Property="Background" Value="#252A30"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ChromeBorder" Property="Opacity" Value="0.68"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <!-- Game edition tab (2016 / 2018). Active state: Background/BorderBrush set from code. -->
            <Style x:Key="EditionTabStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#E8E8E8"/><Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="16,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="HoverLayer" Background="#18FFFFFF" CornerRadius="7" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverLayer" Property="Opacity" Value="1"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="TabBorder" Property="Opacity" Value="0.7"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.TaskbarItemInfo><TaskbarItemInfo x:Name="taskbarIcon" Description="JSEmu Launcher"/></Window.TaskbarItemInfo>

    <Viewbox Stretch="Uniform">
    <Border Width="1440" Height="810" Background="#080B0E" BorderBrush="#252B30" BorderThickness="1" CornerRadius="15" ClipToBounds="True"
            MouseLeftButtonDown="MoveWindow">
        <Grid>
            <Grid.Background><RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.85" RadiusY="1.1">
                <GradientStop Color="#14181C" Offset="0"/><GradientStop Color="#090C0F" Offset="0.55"/><GradientStop Color="#050709" Offset="1"/>
            </RadialGradientBrush></Grid.Background>
            <Grid.RowDefinitions><RowDefinition Height="205"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>

            <!-- Cinematic hero and window actions -->
            <Grid Grid.Row="0" ClipToBounds="True">
                <Image Source="..\Resources\UserHeroBanner.png"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       IsHitTestVisible="False"/>
                <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#18000000" Offset="0"/><GradientStop Color="#06000000" Offset="0.48"/><GradientStop Color="#E6080B0E" Offset="1"/>
                </LinearGradientBrush></Border.Background></Border>
                <!-- 2018 mode: warm tint over the banner (under the controls) -->
                <Border x:Name="tint2018" IsHitTestVisible="False" Visibility="Collapsed">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#40E0902A" Offset="0"/><GradientStop Color="#10E0902A" Offset="0.55"/><GradientStop Color="#35B8561A" Offset="1"/>
                    </LinearGradientBrush></Border.Background>
                </Border>
                <!-- KOTK mode: cold blue tint over the banner -->
                <Border x:Name="tintKotK" IsHitTestVisible="False" Visibility="Collapsed">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#403D8EE8" Offset="0"/><GradientStop Color="#103D8EE8" Offset="0.55"/><GradientStop Color="#351A4FB8" Offset="1"/>
                    </LinearGradientBrush></Border.Background>
                </Border>
                <Border Width="38" Height="38" Margin="18" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CA090C10" BorderBrush="#3B4146" BorderThickness="1" CornerRadius="9">
                    <Grid><Ellipse Width="13" Height="13" Stroke="#DDE1E5" StrokeThickness="1.5"/><Rectangle Width="3" Height="8" Fill="#E61D2B" RadiusX="1" RadiusY="1"/></Grid>
                </Border>
                <!-- Game edition switch: 2016 (existing) / 2018 (Steam build, JSEmu 2018 server) -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="66,16,0,0" Background="#E6070A0D" BorderBrush="#2C3237" BorderThickness="1" CornerRadius="10" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="GAME" Foreground="#6E757C" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,10,0">
                            <TextBlock.LayoutTransform><RotateTransform Angle="-90"/></TextBlock.LayoutTransform>
                        </TextBlock>
                        <Button x:Name="edition2016Button" Tag="2016" Click="EditionButtonClick" Height="44" MinWidth="96" Style="{StaticResource EditionTabStyle}" ToolTip="Just Survive 2016 - classic JSEmu servers">
                            <StackPanel>
                                <TextBlock Text="2016" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="edition2016Sub" Text="CLASSIC" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#9AA0A6"/>
                            </StackPanel>
                        </Button>
                        <Border Width="4"/>
                        <Button x:Name="edition2018Button" Tag="2018" Click="EditionButtonClick" Height="44" MinWidth="96" Style="{StaticResource EditionTabStyle}" ToolTip="Just Survive 2018 - Steam build, JSEmu 2018 server">
                            <StackPanel>
                                <TextBlock Text="2018" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="edition2018Sub" Text="STEAM" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#9AA0A6"/>
                            </StackPanel>
                        </Button>
                        <Border Width="4"/>
                        <Button x:Name="editionKotKButton" Tag="KOTK" Click="EditionButtonClick" Height="44" MinWidth="96" Style="{StaticResource EditionTabStyle}" ToolTip="King of the Kill - Pre-Season 5, JSEmu KOTK server">
                            <StackPanel>
                                <TextBlock Text="KOTK" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="editionKotKSub" Text="PRE-SEASON 5" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#9AA0A6"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <!-- 2018 mode: edition badge under the logo -->
                <Border x:Name="badge2018" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,172,0,0" Padding="14,3" CornerRadius="12" Background="#CC1A1208" BorderBrush="#E8A33D" BorderThickness="1" IsHitTestVisible="False">
                    <TextBlock Text="2 0 1 8   E D I T I O N   ·   S T E A M" Foreground="#F2B24E" FontSize="11" FontWeight="Bold"/>
                </Border>
                <Border x:Name="badgeKotK" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,172,0,0" Padding="14,3" CornerRadius="12" Background="#CC08121A" BorderBrush="#3D8EE8" BorderThickness="1" IsHitTestVisible="False">
                    <TextBlock Text="K I N G   O F   T H E   K I L L   ·   P R E - S E A S O N   5" Foreground="#6FB2F5" FontSize="11" FontWeight="Bold"/>
                </Border>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" Background="#DC070A0D" BorderBrush="#2C3237" BorderThickness="1" CornerRadius="7">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SettingsButton" Width="50" Height="42" Click="SettingsButtonClick" Style="{StaticResource ChromeButtonStyle}" ToolTip="Settings">
                            <Path x:Name="settingsButtonIcon" Data="{DynamicResource SettingsIcon}" Width="17" Height="17" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"><Path.RenderTransform><RotateTransform x:Name="rotateSettingsIcon"/></Path.RenderTransform></Path>
                        </Button>
                        <Button x:Name="MinimiseToSystemTrayButton" Width="50" Height="42" Click="MinimiseToSystemTrayButtonClick" Style="{StaticResource ChromeButtonStyle}" ToolTip="Minimize to tray">
                            <Path Data="{DynamicResource MinimiseToSystemTrayIcon}" Width="13" Height="13" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="MinimiseButton" Width="50" Height="42" Click="MinimiseButtonClick" Style="{StaticResource ChromeButtonStyle}" ToolTip="Minimize">
                            <Path Data="{DynamicResource MinimiseIcon}" Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Button x:Name="ExitButton" Width="54" Height="42" Click="CloseLauncher" Background="#8E0000" BorderBrush="#B3181D" Style="{StaticResource ChromeButtonStyle}" ToolTip="Close">
                            <Path Data="{DynamicResource XIcon}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>
                </Border>
                <Button x:Name="dressingRoomButton" Click="OpenDressingRoom" Width="218" Height="60" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,10" Background="#E00B0E14" BorderBrush="#5E2024" BorderThickness="1" Foreground="White" Cursor="Hand" ToolTip="Change your skins and outfit">
                    <Button.Template><ControlTemplate TargetType="Button">
                        <Border x:Name="DressBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="15,9">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#E11D2A" CornerRadius="9">
                                    <Path Data="M4,7 L9,4 C9.5,6 14.5,6 15,4 L20,7 L18,11 L16,10 L16,20 L8,20 L8,10 L6,11 Z" Fill="White" Stretch="Uniform" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="DRESSING ROOM" FontWeight="SemiBold" FontSize="14" Foreground="#F5F6F7"/><TextBlock Text="Change your skins" Foreground="#C9A0A4" FontSize="12"/></StackPanel>
                                <Path Grid.Column="2" Data="{DynamicResource RightArrowIcon}" Fill="#E11D2A" Width="7" Height="14" Stretch="Fill"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DressBorder" Property="Background" Value="#2A1014"/><Setter TargetName="DressBorder" Property="BorderBrush" Value="#E11D2A"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="DressBorder" Property="Background" Value="#3A1419"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Button.Template>
                </Button>
                <Button x:Name="hubButton" Tag="Battle Pass, Pimp My Car, Scrap Yard" Click="OpenHub" Width="218" Height="60" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,80" Background="#E00B0E14" BorderBrush="#5A4A22" BorderThickness="1" Foreground="White" Cursor="Hand" ToolTip="Battle Pass, Pimp My Car, Scrap Yard and your coins">
                    <Button.Template><ControlTemplate TargetType="Button">
                        <Border x:Name="HubBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="15,9">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#F2BC55" CornerRadius="15">
                                    <TextBlock Text="C" FontSize="16" FontWeight="Bold" Foreground="#3A2A00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="JSEMU HUB" FontWeight="SemiBold" FontSize="14" Foreground="#F5F6F7"/><TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="#C9B98A" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel>
                                <Path Grid.Column="2" Data="{DynamicResource RightArrowIcon}" Fill="#F2BC55" Width="7" Height="14" Stretch="Fill"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HubBorder" Property="Background" Value="#2A2210"/><Setter TargetName="HubBorder" Property="BorderBrush" Value="#F2BC55"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="HubBorder" Property="Background" Value="#3A2F14"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Button.Template>
                </Button>
                <Button x:Name="discordLink" Click="OpenDiscord" Width="218" Height="60" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,10" Background="#E00B0E14" BorderBrush="#373D50" BorderThickness="1" Foreground="White" Cursor="Hand" ToolTip="Join the JSEmu Discord">
                    <Button.Template><ControlTemplate TargetType="Button">
                        <Border x:Name="DiscordBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="15,9">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#5865F2" CornerRadius="9">
                                    <Viewbox Width="20" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="18">
                                            <Path Data="M3,6 C5,2.5 19,2.5 21,6 L23,13 C23.8,15.8 20,17.5 18,14.7 L16.5,12.8 C13.5,13.8 10.5,13.8 7.5,12.8 L6,14.7 C4,17.5 0.2,15.8 1,13 Z" Fill="White"/>
                                            <Ellipse Canvas.Left="7" Canvas.Top="7.7" Width="3" Height="3" Fill="#5865F2"/>
                                            <Ellipse Canvas.Left="14" Canvas.Top="7.7" Width="3" Height="3" Fill="#5865F2"/>
                                            <Path Data="M8.5,12 C10.5,13.2 13.5,13.2 15.5,12" Stroke="#5865F2" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="JOIN DISCORD" FontWeight="SemiBold" FontSize="14" Foreground="#F5F6F7"/><TextBlock Text="Join our community" Foreground="#AEB4D7" FontSize="12"/></StackPanel>
                                <Path Grid.Column="2" Data="{DynamicResource RightArrowIcon}" Fill="#7C87FF" Width="7" Height="14" Stretch="Fill"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DiscordBorder" Property="Background" Value="#171A2A"/><Setter TargetName="DiscordBorder" Property="BorderBrush" Value="#5865F2"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="DiscordBorder" Property="Background" Value="#202442"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Button.Template>
                    <Button.ContextMenu><ContextMenu Style="{DynamicResource ContextMenuStyle}"><MenuItem x:Name="discordLinkCopyMenuItem" Click="DiscordLinkCopyClick" Header="{DynamicResource item193}" Style="{DynamicResource CustomMenuItem}"/></ContextMenu></Button.ContextMenu>
                </Button>
            </Grid>

            <!-- Two-card workspace -->
            <Grid Grid.Row="1" Margin="28,0,28,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="620"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="28,22">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="42" Height="42" Margin="0,0,14,0" Background="#16191D" BorderBrush="#5E2024" BorderThickness="1" CornerRadius="8">
                                <Path Data="M3,10 L9,10 L15,5 L15,19 L9,14 L3,14 Z M18,8 C20,10 20,14 18,16" Stroke="#EF2731" StrokeThickness="2" Stretch="Uniform" Width="24" Height="24"/>
                            </Border>
                            <TextBlock VerticalAlignment="Center" FontSize="28" FontWeight="Bold"><Run Text="JSEmu " Foreground="#F0F1F3"/><Run x:Name="updateVersion" Foreground="#EF2731"/><Run x:Name="datePublished" FontSize="13" Foreground="#777E85"/></TextBlock>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ScrollViewer MaxHeight="94" VerticalScrollBarVisibility="Hidden" Style="{DynamicResource CustomScrollViewer}"><TextBlock x:Name="patchNotesBox" Foreground="#C5C9CE" FontSize="15" LineHeight="22" TextWrapping="Wrap" Style="{DynamicResource TextBlockStyle}"/></ScrollViewer>
                            <TextBlock Grid.Row="1" Margin="0,10,0,0" FontSize="14"><Hyperlink NavigateUri="https://discord.com/channels/1416363907336896544/1425465707339972629" RequestNavigate="FullUpdatesHyperlink" Foreground="#EF2731" Style="{DynamicResource HyperLinkStyle}"><Run Text="View updates on Discord...   →"/></Hyperlink>
                                <TextBlock.ContextMenu><ContextMenu Style="{DynamicResource ContextMenuStyle}"><MenuItem Click="PatchNotesCopyClick" Header="{DynamicResource item193}" Style="{DynamicResource CustomMenuItem}"/></ContextMenu></TextBlock.ContextMenu>
                            </TextBlock>
                        </Grid>
                        <Border Grid.Row="2" Background="#080A0D" CornerRadius="9" ClipToBounds="True"><Grid>
                            <Image Source="..\Resources\Placeholder.jpg" Stretch="UniformToFill" Opacity="0.52"/>
                            <Grid x:Name="imageCarousel" ClipToBounds="True" MouseEnter="CarouselMouseEnter" MouseLeave="CarouselMouseLeave">
                                <Image x:Name="carouselImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"><Image.RenderTransform><TranslateTransform x:Name="carouselImageTranslate"/></Image.RenderTransform></Image>
                                <Image x:Name="carouselImageFollow" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"><Image.RenderTransform><TranslateTransform x:Name="carouselImageFollowTranslate"/></Image.RenderTransform></Image>
                                <Button x:Name="nextImage" Click="NextImageClick" Width="36" Height="56" Opacity="0" HorizontalAlignment="Right" Background="#A0000000" BorderThickness="0" Style="{DynamicResource CarouselButton}"><Path Data="{DynamicResource RightArrowIcon}" Fill="White" Width="8" Height="17"/></Button>
                                <Button x:Name="prevImage" Click="PrevImageClick" Width="36" Height="56" Opacity="0" HorizontalAlignment="Left" Background="#A0000000" BorderThickness="0" Style="{DynamicResource CarouselButton}"><Path Data="{DynamicResource LeftArrowIcon}" Fill="White" Width="8" Height="17"/></Button>
                                <Grid x:Name="carouselRectangleGrid" VerticalAlignment="Bottom" Height="5" Margin="6,0,6,6"><Rectangle Fill="#373B40" RadiusX="2" RadiusY="2"/><Rectangle x:Name="carouselRectangle" Fill="#F0202A" HorizontalAlignment="Left" RadiusX="2" RadiusY="2"/></Grid>
                            </Grid>
                        </Grid></Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="22">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource InnerCardStyle}" Padding="24,16" Margin="0,0,0,14"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Data="{DynamicResource ShieldIcon}" Width="30" Height="34" Stretch="Uniform" Fill="#F0202A" VerticalAlignment="Top" Margin="0,1,0,0"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" LineHeight="22" Foreground="#D4D7DB"><Run Text="{DynamicResource item10}" Foreground="#F0202A" FontWeight="Bold"/><Run Text=" "/><Run Text="{DynamicResource item11}"/><LineBreak/><LineBreak/><Run Text="{DynamicResource item50}"/></TextBlock>
                        </Grid></Border>
                        <Frame x:Name="steamFramePanel" Grid.Row="1" Margin="0,0,0,8" Height="140" Source="..\SteamFramePages\Login.xaml" NavigationUIVisibility="Hidden" f:DisableFrameNavigation.Disable="True"/>
                        <!-- KOTK mode: no Steam login; the game downloads from the KOTK server's manifest -->
                        <Border x:Name="kotkPanel" Grid.Row="1" Margin="0,0,0,8" Height="140" Visibility="Collapsed" Background="#0B1118" BorderBrush="#1E3A55" BorderThickness="1" CornerRadius="6" Padding="16,12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="KOTK NAME" Foreground="#72889A" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox x:Name="kotkNameBox" Grid.Column="1" Height="34" Padding="10,0" MaxLength="24" VerticalContentAlignment="Center" Background="#11151A" BorderBrush="#1E5A8A" BorderThickness="1" Style="{DynamicResource TextBoxStyle}" LostFocus="KotKNameChanged" ToolTip="3-24 letters, digits or _. Used the first time your account key signs in to KOTK."/>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <Button x:Name="kotkHubButton" Content="FRIENDS &amp; PARTY" Height="34" MinWidth="150" Margin="0,0,8,0" Click="KotKHubClick" Style="{DynamicResource PrimaryButton}" FontSize="13" ToolTip="Friends, party, messages, leaderboard, profile picture and voice"/>
                                        <Button x:Name="kotkRepairButton" Content="INSTALL / REPAIR" Height="34" MinWidth="140" Margin="0,0,8,0" Click="KotKRepairClick" Style="{DynamicResource PrimaryButton}" FontSize="13" ToolTip="Check every game file and download only what is missing or changed"/>
                                        <Button x:Name="kotkCancelButton" Content="CANCEL" Height="34" MinWidth="90" Visibility="Collapsed" Click="KotKCancelClick" Style="{DynamicResource PrimaryButton}" FontSize="13"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="kotkStatus" Grid.Row="1" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="#C9D3DC" FontSize="13" Text="Press Play - the launcher downloads KOTK (about 14.6 GB) and signs you in with your account key."/>
                                <ProgressBar x:Name="kotkProgress" Grid.Row="2" Height="10" Minimum="0" Maximum="100" Value="0" Style="{DynamicResource ProgressBar}"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Rectangle Height="1" Fill="#30353A" Margin="0,0,16,0"/><TextBlock x:Name="currentGame" Grid.Column="1" Foreground="#92989F" FontSize="13" FontWeight="SemiBold" Text="{DynamicResource item69}"/><Rectangle Grid.Column="2" Height="1" Fill="#30353A" Margin="16,0,0,0"/>
                        </Grid>
                        <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="245"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="14"/><RowDefinition Height="52"/></Grid.RowDefinitions>
                            <Grid><TextBox x:Name="directoryBox" Height="48" Padding="42,0,42,0" IsReadOnly="True" VerticalContentAlignment="Center" Text="{DynamicResource item75}" Background="#11151A" BorderBrush="#7F252A" BorderThickness="1" Style="{DynamicResource TextBoxStyle}"/>
                                <Button Click="OpenDirectory" Width="22" Height="22" Margin="14,0,0,0" HorizontalAlignment="Left" Style="{DynamicResource PathButton}"><Path Data="{DynamicResource FolderIcon}" Stroke="#E8E8E8" StrokeThickness="1.5" Stretch="Uniform"/></Button>
                                <Button x:Name="directoryButton" Click="SelectDirectory" Width="22" Height="22" Margin="0,0,14,0" HorizontalAlignment="Right" Style="{DynamicResource PathButton}"><Path Data="{DynamicResource ArrowIcon}" Fill="#E8E8E8" Stretch="Uniform"/></Button>
                            </Grid>
                            <Grid Grid.Row="2"><ComboBox x:Name="serverSelector" Height="52" Padding="42,0,12,0" SelectedIndex="0" VerticalContentAlignment="Center" SelectionChanged="ServerSelectorChanged" Background="#11151A" BorderBrush="#7F252A" BorderThickness="1" Foreground="#E7E9ED" Style="{DynamicResource ComboBoxStyle}">
                                <ComboBoxItem Content="JSEmu Servers" Style="{DynamicResource ComboBoxItemStyle}"/><ComboBoxItem Content="H1Emu Servers" Style="{DynamicResource ComboBoxItemStyle}"/><ComboBoxItem Content="Singleplayer" Style="{DynamicResource ComboBoxItemStyle}"/><Separator Background="#3A3E43"/><ComboBoxItem Content="New Server..." PreviewMouseLeftButtonUp="AddNewServerClick" Style="{DynamicResource ComboBoxItemStyle}"/>
                            </ComboBox><Path x:Name="serverSelectorIcon" Data="M2,7 L12,2 L22,7 L12,12 Z M2,12 L12,17 L22,12 M2,17 L12,22 L22,17" Stroke="#E8E8E8" StrokeThickness="1.4" Width="22" Height="22" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False"/>
                                <!-- 2018 mode: fixed server instead of the server list -->
                                <Border x:Name="server2018Info" Visibility="Collapsed" Height="52" Background="#15110B" BorderBrush="#8A5A1E" BorderThickness="1" CornerRadius="6">
                                    <Grid Margin="14,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Path Data="M2,7 L12,2 L22,7 L12,12 Z M2,12 L12,17 L22,12 M2,17 L12,22 L22,17" Stroke="#F2B24E" StrokeThickness="1.4" Width="22" Height="22" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <TextBlock Text="JSEmu 2018 Server" Foreground="#F2F3F5" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="Just Survive 2018 · Steam build 2.1.886508" Foreground="#9A8A72" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="#52B84A" Margin="0,0,6,0"/><TextBlock Text="EU" Foreground="#52B84A" FontSize="11" FontWeight="Bold"/></StackPanel>
                                    </Grid>
                                </Border>
                                <!-- KOTK mode: fixed server, reached through the launcher's encrypted tunnel -->
                                <Border x:Name="serverKotKInfo" Visibility="Collapsed" Height="52" Background="#0B1118" BorderBrush="#1E5A8A" BorderThickness="1" CornerRadius="6">
                                    <Grid Margin="14,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Path Data="M2,7 L12,2 L22,7 L12,12 Z M2,12 L12,17 L22,12 M2,17 L12,22 L22,17" Stroke="#6FB2F5" StrokeThickness="1.4" Width="22" Height="22" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <TextBlock Text="JSEmu KOTK Server" Foreground="#F2F3F5" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="King of the Kill · Solo / Duos / Fives" Foreground="#72889A" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="#52B84A" Margin="0,0,6,0"/><TextBlock Text="EU" Foreground="#52B84A" FontSize="11" FontWeight="Bold"/></StackPanel>
                                    </Grid>
                                </Border></Grid>
                            <Button x:Name="playButton" Grid.Column="2" Grid.RowSpan="3" Click="LaunchClient" Height="98" VerticalAlignment="Bottom" FontSize="30" FontWeight="Bold" Content="{DynamicResource item8}" BorderBrush="#E11D27" BorderThickness="1" Style="{DynamicResource PrimaryButton}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="10" Height="10" Fill="#52B84A" Margin="0,0,10,0"/><TextBlock Text="ONLINE" Foreground="#52B84A" FontSize="12" FontWeight="SemiBold"/></StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#666C72" FontSize="11" FontWeight="SemiBold"><Run Text="J S E M U . E U    |    J U S T   S U R V I V E .  "/><Run Text="A G A I N ." Foreground="#E31D27"/></TextBlock>
                <TextBlock x:Name="copyrightNotice" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#666C72" FontSize="12" Text="Launcher Version: 3.5.15" Style="{DynamicResource TextBlockStyle}"/>
                <TextBlock x:Name="chineseLink" Visibility="Collapsed"><Hyperlink NavigateUri="https://azaz.ge/" RequestNavigate="H1EmuChineseLink"/><TextBlock.ContextMenu><ContextMenu Style="{DynamicResource ContextMenuStyle}"><MenuItem Click="ChineseLinkCopyClick" Header="{DynamicResource item193}" Style="{DynamicResource CustomMenuItem}"/></ContextMenu></TextBlock.ContextMenu></TextBlock>
            </Grid>
        </Grid>
    </Border>
    </Viewbox>
</Window>
