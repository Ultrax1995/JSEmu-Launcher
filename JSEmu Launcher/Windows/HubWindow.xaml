<Window x:Class="H1Emu_Launcher.HubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Width="1180" Height="760"
        UseLayoutRounding="True"
        FontFamily="Bahnschrift Light"
        Foreground="#DDE3E8"
        Loaded="WindowLoaded">

    <Window.Resources>
        <Style x:Key="HubButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DDE3E8"/>
            <Setter Property="Background" Value="#151A20"/>
            <Setter Property="BorderBrush" Value="#2C3540"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#E11D2A"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#080B0E" BorderBrush="#252B30" BorderThickness="1" CornerRadius="15" ClipToBounds="True">
        <Grid>
            <Grid.Background>
                <RadialGradientBrush Center="0.2,0" GradientOrigin="0.2,0" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#2A0F13" Offset="0"/>
                    <GradientStop Color="#0A0D10" Offset="0.55"/>
                    <GradientStop Color="#050709" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="84"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragWindow" Margin="30,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,30,0">
                        <TextBlock Text="JSEMU.EU" FontSize="11" FontWeight="Bold" Foreground="#E11D2A"/>
                        <TextBlock FontSize="28" FontWeight="Bold"><Run Text="JSEmu "/><Run Text="Hub" Foreground="#E11D2A"/></TextBlock>
                    </StackPanel>
                    <Button x:Name="tabBattlepass" Content="Battle Pass" Click="TabClick" Tag="battlepass" Height="40" Margin="0,0,10,0" Style="{StaticResource HubButton}"/>
                    <Button x:Name="tabStore" Content="Crate Store" Click="TabClick" Tag="store" Height="40" Margin="0,0,10,0" Style="{StaticResource HubButton}"/>
                    <Button x:Name="tabPimp" Content="Pimp My Car" Click="TabClick" Tag="pimp" Height="40" Margin="0,0,10,0" Style="{StaticResource HubButton}"/>
                    <Button x:Name="tabScrap" Content="Scrap Yard" Click="TabClick" Tag="scrap" Height="40" Style="{StaticResource HubButton}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1B160A" BorderBrush="#5A4A22" BorderThickness="1" CornerRadius="9" Padding="14,0" Height="40" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="22" Height="22" Background="#F2BC55" CornerRadius="11" Margin="0,0,9,0">
                                <TextBlock Text="C" FontSize="13" FontWeight="Bold" Foreground="#3A2A00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="coinsText" Text="-" FontSize="16" FontWeight="Bold" Foreground="#F2BC55" VerticalAlignment="Center"/>
                            <TextBlock Text=" coins" FontSize="13" Foreground="#C9B98A" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Gambling (web)" Click="GamblingClick" Height="40" Margin="0,0,10,0" Style="{StaticResource HubButton}" ToolTip="Opens the casino on jsemu.eu inside the launcher"/>
                    <Button Width="44" Height="40" Click="CloseClick" Style="{StaticResource HubButton}" Padding="0" ToolTip="Close">
                        <TextBlock Text="X" FontSize="15" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- content -->
            <Border Grid.Row="1" Margin="30,0,30,26" Background="#0E1216" BorderBrush="#252B30" BorderThickness="1" CornerRadius="13">
                <Grid>
                    <ScrollViewer x:Name="scroller" VerticalScrollBarVisibility="Auto" Padding="22,18">
                        <StackPanel x:Name="content"/>
                    </ScrollViewer>
                    <TextBlock x:Name="loadingText" Text="Loading..." FontSize="18" Foreground="#8A96A3"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
