<Window x:Class="H1Emu_Launcher.HubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Width="1120" Height="720"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        Foreground="#DDE3E8"
        Loaded="WindowLoaded">

    <Window.Resources>
        <Style x:Key="HubButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DDE3E8"/>
            <Setter Property="Background" Value="#151A20"/>
            <Setter Property="BorderBrush" Value="#2C3540"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#E11D2A"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Side navigation row, same as the Settings window; HighlightTab paints the open page -->
        <Style x:Key="HubNavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#9AA0A8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{StaticResource Signika}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="27,0,8,0">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#E7E9ED"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2F343A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#D71923"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#D71923"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <!-- Slim dark scrollbar, thumb only -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb"><Border x:Name="Bar" Background="#3A4046" CornerRadius="4" Margin="1,0"/>
                                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="#5A6168"/></Trigger></ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border Background="#08090B" BorderBrush="#2A2E33" BorderThickness="1" CornerRadius="14" ClipToBounds="True" MouseLeftButtonDown="DragWindow">
        <Grid>
            <Image Source="..\Resources\Backdrop2016.png" Stretch="UniformToFill" Opacity="0.75" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
            <Rectangle Fill="#C70A0C0F" IsHitTestVisible="False"/>
            <Rectangle IsHitTestVisible="False" Opacity="0.06">
                <Rectangle.Fill><ImageBrush ImageSource="..\Resources\Grain.png" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,512,512"/></Rectangle.Fill>
            </Rectangle>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="256"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <!-- left rail: logo, pages, coins -->
                <Border Background="#D9090B0E" BorderBrush="#24282D" BorderThickness="0,0,1,0">
                    <DockPanel Margin="16,0">
                        <StackPanel DockPanel.Dock="Top" Margin="6,30,0,26" IsHitTestVisible="False">
                            <Grid Height="30" HorizontalAlignment="Left">
                                <Image Source="..\Resources\LogoWordmark.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Rectangle Fill="{DynamicResource Accent.Brush}">
                                    <Rectangle.OpacityMask><ImageBrush ImageSource="..\Resources\LogoMark.png" Stretch="Uniform"/></Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>
                            <TextBlock Margin="1,10,0,0" Text="J S E M U   H U B" FontFamily="{StaticResource Signika}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent.LightBrush}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,18">
                            <Border Background="#1B160A" BorderBrush="#5A4A22" BorderThickness="1" CornerRadius="8" Padding="14,0" Height="46" Margin="0,0,0,10" IsHitTestVisible="False">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" Background="#F2BC55" CornerRadius="11" Margin="0,0,10,0">
                                        <TextBlock Text="C" FontSize="13" FontWeight="Bold" Foreground="#3A2A00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="coinsText" Text="-" FontFamily="{StaticResource Signika}" FontSize="18" FontWeight="SemiBold" Foreground="#F2BC55" VerticalAlignment="Center"/>
                                    <TextBlock Text=" coins" FontSize="13" Foreground="#C9B98A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Button Content="Donate" Click="DonateClick" Height="42" Margin="0,0,0,8" Style="{StaticResource HubButton}" ToolTip="Opens jsemu.eu in your browser"/>
                            <Button Content="Gambling" Click="GamblingClick" Height="42" Style="{StaticResource HubButton}" ToolTip="Opens jsemu.eu in your browser"/>
                        </StackPanel>
                        <StackPanel>
                            <Button x:Name="tabBattlepass" Click="TabClick" Tag="battlepass" Style="{StaticResource HubNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12,3 L14.8,8.8 L21,9.7 L16.5,14.1 L17.6,20.4 L12,17.4 L6.4,20.4 L7.5,14.1 L3,9.7 L9.2,8.8 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="19" Height="19" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,13,0"/>
                                    <TextBlock Text="Battle Pass" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="tabStore" Click="TabClick" Tag="store" Style="{StaticResource HubNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3,8 L12,3.5 L21,8 L21,17 L12,21.5 L3,17 Z M3,8 L12,12.5 L21,8 M12,12.5 L12,21.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="19" Height="19" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,13,0"/>
                                    <TextBlock Text="Crate Store" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="tabBackpack" Click="TabClick" Tag="backpack" Style="{StaticResource HubNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M9,6 L9,5 C9,3.5 10.3,3 12,3 C13.7,3 15,3.5 15,5 L15,6 M6,21 L18,21 C19.2,21 20,20.2 20,19 L20,11 C20,8 18,6 15,6 L9,6 C6,6 4,8 4,11 L4,19 C4,20.2 4.8,21 6,21 Z M8,13 L16,13 L16,17 L8,17 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="19" Height="19" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,13,0"/>
                                    <TextBlock Text="Backpack" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="tabScrap" Click="TabClick" Tag="scrap" Style="{StaticResource HubNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M4,7 L20,7 M9,7 L9,4 L15,4 L15,7 M6,7 L7,20 L17,20 L18,7 M10,11 L10,16 M14,11 L14,16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="19" Height="19" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,13,0"/>
                                    <TextBlock Text="Scrap Yard" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="tabWipe" Click="TabClick" Tag="wipe" Style="{StaticResource HubNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M7,4 L17,4 L17,10 C17,13 15,15 12,15 C9,15 7,13 7,10 Z M7,6 L4,6 L4,8 C4,10 5.5,11 7.5,11 M17,6 L20,6 L20,8 C20,10 18.5,11 16.5,11 M12,15 L12,19 M8,20 L16,20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="19" Height="19" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,13,0"/>
                                    <TextBlock Text="Wipe Rewards" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- content -->
                <Grid Grid.Column="1">
                    <ScrollViewer x:Name="scroller" VerticalScrollBarVisibility="Auto" Padding="30,24,18,18">
                        <StackPanel x:Name="content"/>
                    </ScrollViewer>
                    <TextBlock x:Name="loadingText" Text="Loading..." FontSize="18" Foreground="#8A96A3"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Grid>

            <Button Click="CloseClick" Width="44" Height="38" Margin="0,22,22,0" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource CloseButton}" ToolTip="Close">
                <Path Data="{DynamicResource XIcon}" Stretch="Uniform" Fill="White" Width="12" Height="12"/>
            </Button>
        </Grid>
    </Border>
</Window>
