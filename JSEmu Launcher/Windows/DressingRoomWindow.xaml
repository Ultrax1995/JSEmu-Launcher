<Window x:Class="H1Emu_Launcher.DressingRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Width="1120" Height="740"
        UseLayoutRounding="True"
        FontFamily="Bahnschrift Light"
        Foreground="#DDE3E8"
        Loaded="WindowLoaded">

    <Window.Resources>
        <Style x:Key="DrButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DDE3E8"/>
            <Setter Property="Background" Value="#151A20"/>
            <Setter Property="BorderBrush" Value="#2C3540"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#E11D2A"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#080B0E" BorderBrush="#252B30" BorderThickness="1" CornerRadius="15" ClipToBounds="True">
        <Grid>
            <Grid.Background>
                <RadialGradientBrush Center="0.2,0" GradientOrigin="0.2,0" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#2A0F13" Offset="0"/>
                    <GradientStop Color="#0A0D10" Offset="0.55"/>
                    <GradientStop Color="#050709" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="86"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="76"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragWindow" Margin="30,0,20,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="JSEMU LOCKER ROOM" FontSize="11" FontWeight="Bold" Foreground="#E11D2A"/>
                    <TextBlock FontSize="30" FontWeight="Bold" Margin="0,2,0,0"><Run Text="Dressing "/><Run Text="Room" Foreground="#E11D2A"/></TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="userLabel" VerticalAlignment="Center" Foreground="#8A96A3" FontSize="13" Margin="0,0,18,0"/>
                    <Button Width="44" Height="38" Click="CloseClick" Style="{StaticResource DrButton}" ToolTip="Close">
                        <TextBlock Text="X" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- body -->
            <Grid Grid.Row="1" Margin="30,0,30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="#0E1216" BorderBrush="#252B30" BorderThickness="1" CornerRadius="13">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel x:Name="slotList"/>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" Background="#0E1216" BorderBrush="#252B30" BorderThickness="1" CornerRadius="13" Padding="18,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="panelTitle" FontSize="22" FontWeight="Bold"/>
                                <TextBlock x:Name="panelCount" FontSize="12" Foreground="#8A96A3"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBox x:Name="searchBox" Width="210" Height="34" Padding="10,0" VerticalContentAlignment="Center"
                                         Background="#151A20" BorderBrush="#2C3540" Foreground="#DDE3E8" CaretBrush="White"
                                         TextChanged="SearchChanged"/>
                                <CheckBox x:Name="showLocked" Content="Show locked" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center"
                                          Foreground="#8A96A3" Checked="ShowLockedChanged" Unchecked="ShowLockedChanged"/>
                            </StackPanel>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <WrapPanel x:Name="ownedPanel"/>
                                <TextBlock x:Name="lockedTitle" Text="LOCKED" FontSize="12" FontWeight="Bold" Foreground="#8A96A3" Margin="0,22,0,10"/>
                                <WrapPanel x:Name="lockedPanel"/>
                                <TextBlock x:Name="emptyText" Foreground="#8A96A3" Margin="0,20,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <TextBlock x:Name="loadingText" Grid.ColumnSpan="3" Text="Opening your locker..." FontSize="18" Foreground="#8A96A3"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- footer -->
            <Grid Grid.Row="2" Margin="30,0,30,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="dirtyDot" Width="10" Height="10" Fill="#45D38A" Margin="0,0,10,0"/>
                    <TextBlock x:Name="statusText" Text="" FontSize="13" Foreground="#8A96A3"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="unequipAllButton" Content="Unequip all" Click="UnequipAllClick" Height="42" Padding="22,0" Margin="0,0,10,0" Style="{StaticResource DrButton}"/>
                    <Button x:Name="resetButton" Content="Reset" Click="ResetClick" Height="42" Padding="22,0" Margin="0,0,10,0" Style="{StaticResource DrButton}"/>
                    <Button x:Name="saveButton" Content="Save outfit" Click="SaveClick" Height="42" Padding="28,0" Background="#E11D2A" BorderBrush="#F02A36" Foreground="White" Style="{StaticResource DrButton}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
