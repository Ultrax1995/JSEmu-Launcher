<UserControl x:Class="H1Emu_Launcher.KotKSocialPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="640"
             FontFamily="Bahnschrift" Foreground="#EEEAE2"
             Loaded="PanelLoaded" Unloaded="PanelUnloaded">

    <!-- KOTK side panel of the launcher window: signed-in player, party, friends and invitations.
         Leaderboard, profile and settings open the KOTK hub window on that page. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="KotKTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- player -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="56" Height="56" CornerRadius="3" Background="#1D1A14" BorderBrush="{StaticResource KotK.Gold}" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <TextBlock x:Name="meInitial" Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource KotK.DisplayBold}" FontSize="26" Foreground="{StaticResource KotK.Gold}"/>
                    <Image x:Name="meAvatar" Stretch="UniformToFill"/>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="SIGNED IN AS" FontFamily="{StaticResource KotK.Display}" FontSize="11" Foreground="{StaticResource KotK.Dim}"/>
                <TextBlock x:Name="meName" Text="SIGNING IN..." FontFamily="{StaticResource KotK.DisplayBold}" FontSize="24" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="meDot" Width="8" Height="8" Fill="{StaticResource KotK.Dim}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="meStatus" Text="CONNECTING" FontFamily="{StaticResource KotK.Display}" FontSize="12" Foreground="{StaticResource KotK.Muted}"/>
                </StackPanel>
            </StackPanel>
            <Button x:Name="settingsButton" Grid.Column="2" Width="34" Height="34" Padding="0" Tag="voice" Click="HubPageClick" Style="{StaticResource KotK.Button}" VerticalAlignment="Top" ToolTip="KOTK settings: voice and game fixes">
                <Path Data="{DynamicResource SettingsIcon}" Width="15" Height="15" Stretch="Uniform" Fill="{StaticResource KotK.Muted}"/>
            </Button>
        </Grid>

        <!-- tabs -->
        <Grid Grid.Row="1" Height="38" Margin="0,0,0,12">
            <Border BorderBrush="{StaticResource KotK.Border}" BorderThickness="0,0,0,1"/>
            <UniformGrid Rows="1">
                <Button x:Name="tabParty" Tag="party" Click="TabClick" Style="{StaticResource KotK.TabButton}" Content="PARTY"/>
                <Button x:Name="tabFriends" Tag="friends" Click="TabClick" Style="{StaticResource KotK.TabButton}" Content="FRIENDS"/>
                <Button x:Name="tabInvites" Tag="invites" Click="TabClick" Style="{StaticResource KotK.TabButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="INVITES" VerticalAlignment="Center"/>
                        <Border x:Name="invitesBadge" Visibility="Collapsed" Margin="7,0,0,0" MinWidth="20" Height="18" CornerRadius="9" Background="{StaticResource KotK.Red}" Padding="5,0" VerticalAlignment="Center">
                            <TextBlock x:Name="invitesCount" Text="0" FontFamily="{StaticResource KotK.DisplayBold}" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Grid>

        <!-- PARTY -->
        <Grid x:Name="pageParty" Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="MODE" Style="{StaticResource KotK.Heading}" Margin="0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="modeSolo" Content="SOLO" Tag="Solo" Click="ModeClick" Margin="0,0,6,0" MinWidth="64" Style="{StaticResource KotK.ChipButton}"/>
                    <Button x:Name="modeDuos" Content="DUOS" Tag="Duos" Click="ModeClick" Margin="0,0,6,0" MinWidth="64" Style="{StaticResource KotK.ChipButton}"/>
                    <Button x:Name="modeFives" Content="FIVES" Tag="Fives" Click="ModeClick" MinWidth="64" Style="{StaticResource KotK.ChipButton}"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="partyHeading" Grid.Row="1" Text="YOUR PARTY" Style="{StaticResource KotK.Heading}"/>
            <ListBox x:Name="partyList" Grid.Row="2" Style="{StaticResource KotK.List}" ItemTemplate="{StaticResource KotK.PersonRow}"/>
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="readyButton" Content="READY" Click="ReadyClick" Height="38" FontSize="16" Style="{StaticResource KotK.GoldButton}"/>
                <Button x:Name="queueButton" Grid.Column="2" Content="START QUEUE" Click="QueueClick" Height="38" FontSize="15" Style="{StaticResource KotK.Button}"
                        ToolTip="Leader only: every member ready and in the game menu"/>
                <Button x:Name="leaveButton" Grid.Column="4" Content="LEAVE" Click="LeaveClick" Height="38" Style="{StaticResource KotK.DangerButton}"/>
            </Grid>
        </Grid>

        <!-- FRIENDS -->
        <Grid x:Name="pageFriends" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="addFriendBox" Style="{StaticResource KotK.Field}" MaxLength="24" KeyDown="AddFriendKeyDown" TextChanged="AddFriendTextChanged"/>
                <TextBlock x:Name="addFriendHint" Text="Add a friend by account name" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource KotK.Dim}" IsHitTestVisible="False"/>
                <Button Grid.Column="1" Content="ADD FRIEND" Click="AddFriendClick" Margin="8,0,0,0" Style="{StaticResource KotK.GoldButton}"/>
            </Grid>
            <TextBlock x:Name="friendsHeading" Grid.Row="1" Text="FRIENDS" Style="{StaticResource KotK.Heading}"/>
            <Grid Grid.Row="2">
                <ListBox x:Name="friendsList" Style="{StaticResource KotK.List}" ItemTemplate="{StaticResource KotK.PersonRow}"
                         SelectionChanged="SelectionChanged" MouseDoubleClick="MessageClick"/>
                <TextBlock x:Name="friendsEmpty" Visibility="Collapsed" Margin="24" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{StaticResource KotK.Muted}" FontSize="13" Text="No friends yet. Add a player by the name they use in the KOTK launcher."/>
            </Grid>
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="messageButton" Content="MESSAGE" Click="MessageClick" Height="38" IsEnabled="False" Style="{StaticResource KotK.Button}"/>
                <Button x:Name="inviteButton" Grid.Column="2" Content="INVITE TO PARTY" Click="InviteClick" Height="38" IsEnabled="False" Style="{StaticResource KotK.GoldButton}"/>
                <Button x:Name="removeButton" Grid.Column="4" Content="REMOVE" Click="RemoveClick" Height="38" IsEnabled="False" Style="{StaticResource KotK.DangerButton}"/>
            </Grid>
        </Grid>

        <!-- INVITES -->
        <Grid x:Name="pageInvites" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="invitesHeading" Text="FRIEND REQUESTS AND PARTY INVITATIONS" Style="{StaticResource KotK.Heading}"/>
            <Grid Grid.Row="1">
                <ListBox x:Name="invitesList" Style="{StaticResource KotK.List}" ItemTemplate="{StaticResource KotK.PersonRow}" SelectionChanged="SelectionChanged"/>
                <TextBlock x:Name="invitesEmpty" Margin="24" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{StaticResource KotK.Muted}" FontSize="13" Text="No pending requests or invitations."/>
            </Grid>
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="acceptButton" Content="ACCEPT" Click="AcceptClick" Height="38" FontSize="16" IsEnabled="False" Style="{StaticResource KotK.GoldButton}"/>
                <Button x:Name="declineButton" Grid.Column="2" Content="DECLINE" Click="DeclineClick" Height="38" IsEnabled="False" Style="{StaticResource KotK.DangerButton}"/>
            </Grid>
        </Grid>

        <!-- no account key / server unreachable -->
        <Border x:Name="signInPanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Background="{StaticResource KotK.Bg}" BorderBrush="{StaticResource KotK.Border}" BorderThickness="1" CornerRadius="3">
            <StackPanel VerticalAlignment="Center" Margin="30,0">
                <Path Data="{StaticResource KotK.CrownIcon}" Fill="{StaticResource KotK.Gold}" Width="46" Height="46" Stretch="Uniform" Margin="0,0,0,14"/>
                <TextBlock Text="JOIN THE FIGHT" HorizontalAlignment="Center" FontFamily="{StaticResource KotK.DisplayBold}" FontSize="26"/>
                <TextBlock x:Name="signInText" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,18" Foreground="{StaticResource KotK.Muted}" FontSize="13"
                           Text="KOTK signs you in with your JSEmu account key. Set it once to see your friends, party and invitations."/>
                <Button x:Name="signInButton" Content="SET ACCOUNT KEY" Click="SignInClick" Height="40" FontSize="16" HorizontalAlignment="Center" Padding="26,0" Style="{StaticResource KotK.GoldButton}"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="statusText" Grid.Row="3" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource KotK.Muted}" TextTrimming="CharacterEllipsis"/>

        <!-- the rest of the KOTK hub -->
        <UniformGrid Grid.Row="4" Rows="1" Margin="0,10,0,0">
            <Button x:Name="leaderboardButton" Tag="leaderboard" Click="HubPageClick" Height="40" Margin="0,0,6,0" Style="{StaticResource KotK.Button}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource KotK.TrophyIcon}" Stroke="{StaticResource KotK.Gold}" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="LEADERBOARD" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="profileButton" Tag="profile" Click="HubPageClick" Height="40" Margin="3,0,3,0" Style="{StaticResource KotK.Button}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource KotK.PersonIcon}" Fill="{StaticResource KotK.Gold}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="PROFILE" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="overlayButton" Click="OverlayClick" Height="40" Margin="6,0,0,0" Style="{StaticResource KotK.Button}" ToolTip="Friends overlay in the game - same as Shift+Tab">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource KotK.ChatIcon}" Fill="{StaticResource KotK.Gold}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="OVERLAY" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </UniformGrid>
    </Grid>
</UserControl>
