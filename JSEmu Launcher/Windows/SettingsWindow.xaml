<Window x:Class="H1Emu_Launcher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" UseLayoutRounding="True"
        Title="{DynamicResource item206}" x:Name="Settings"
        Width="860" Height="620" MinWidth="860" MaxWidth="860"
        MinHeight="620" MaxHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="Transparent" FontFamily="Segoe UI" FontSize="15" Foreground="#E7E9ED"
        Loaded="SettingsLoaded" ContentRendered="SettingsWindowContentRendered"
        Closing="SettingsWindowClosing">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="1" CaptionHeight="0" NonClientFrameEdges="Bottom, Left, Right"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Language\StringResources.en-EN.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SettingsTabItemStyle" TargetType="TabItem">
                <Setter Property="Foreground" Value="#858C95"/>
                <Setter Property="Background" Value="#CC0D1013"/>
                <Setter Property="FontFamily" Value="{StaticResource Signika}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="MinWidth" Value="124"/>
                <Setter Property="Height" Value="46"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabSurface" Background="{TemplateBinding Background}"
                                    BorderBrush="#2A2E33" BorderThickness="1"
                                    CornerRadius="6" SnapsToDevicePixels="True">
                                <Grid>
                                    <ContentPresenter ContentSource="Header"
                                                      Margin="12,0"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border x:Name="ActiveMarker" Height="3"
                                            VerticalAlignment="Bottom" Margin="9,0,9,0"
                                            Background="{DynamicResource Accent.Brush}" CornerRadius="2,2,0,0" Opacity="0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#E0E3E7"/>
                                    <Setter TargetName="TabSurface" Property="Background" Value="#E6161A1E"/>
                                    <Setter TargetName="TabSurface" Property="BorderBrush" Value="#3A4046"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Accent.SoftBrush}"/>
                                    <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Accent.BorderBrush}"/>
                                    <Setter TargetName="ActiveMarker" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingsTabControlStyle" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid Background="{TemplateBinding Background}" ClipToBounds="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <UniformGrid Grid.Row="0" IsItemsHost="True"
                                             Rows="1" Columns="6"
                                             Margin="4,10,6,10" Panel.ZIndex="2"
                                             Background="Transparent"
                                             KeyboardNavigation.TabIndex="1"/>
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  Grid.Row="1" Panel.ZIndex="1"
                                                  ContentSource="SelectedContent"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  SnapsToDevicePixels="True"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingsCloseButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#A90C12"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#D71B25"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D71923"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Same look as the launcher window: edition backdrop, glass panels, accent line (Accent.* = 2016 red / 2018 ember). -->
    <Border Background="#08090B" BorderBrush="#2A2E33" BorderThickness="1"
            CornerRadius="14" ClipToBounds="True"
            MouseLeftButtonDown="MoveSettingsWindow">
        <Grid>
            <Image x:Name="backdrop" Source="..\Resources\Backdrop2016.png" Stretch="UniformToFill" Opacity="0.75" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
            <Rectangle IsHitTestVisible="False" Opacity="0.06">
                <Rectangle.Fill><ImageBrush ImageSource="..\Resources\Grain.png" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,512,512"/></Rectangle.Fill>
            </Rectangle>
            <Grid>
            <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="26,0,0,0" VerticalAlignment="Center">
                    <Grid Height="28" HorizontalAlignment="Left">
                        <Image Source="..\Resources\LogoWordmark.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Rectangle Fill="{DynamicResource Accent.Brush}">
                            <Rectangle.OpacityMask><ImageBrush ImageSource="..\Resources\LogoMark.png" Stretch="Uniform"/></Rectangle.OpacityMask>
                        </Rectangle>
                    </Grid>
                    <TextBlock x:Name="settingsSubtitle" Margin="1,8,0,0" FontFamily="{StaticResource Signika}" FontSize="11" FontWeight="SemiBold" Foreground="#80868D"><Run Text="L A U N C H E R   S E T T I N G S   ·   "/><Run x:Name="settingsEdition" Text="2 0 1 6" Foreground="{DynamicResource Accent.LightBrush}"/></TextBlock>
                </StackPanel>
                <Button x:Name="ExitButton" Grid.Column="1" Click="CloseSettingsWindow"
                        Width="46" Height="38" Margin="0,0,20,0" VerticalAlignment="Center"
                        Style="{StaticResource SettingsCloseButtonStyle}">
                    <Path Data="{DynamicResource XIcon}" Stretch="Uniform" Fill="White" Width="12" Height="12"/>
                </Button>
                <Rectangle Grid.ColumnSpan="2" Height="1" Margin="22,0" Fill="{DynamicResource Accent.LineBrush}" Opacity="0.8" VerticalAlignment="Bottom"/>
            </Grid>

            <Border Grid.Row="1" Margin="22,16,22,22" Background="#E60C0E11"
                    BorderBrush="#2A2E33" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <TabControl x:Name="settingsTabControl" Background="Transparent" BorderThickness="0"
                            Style="{StaticResource SettingsTabControlStyle}"
                            Padding="0" Margin="5,2,5,5" SelectionChanged="SettingsTabControlSelectionChanged">
                    <TabItem Header="{DynamicResource item195}" Style="{StaticResource SettingsTabItemStyle}">
                        <Frame Source="..\SettingsPages\GameFiles.xaml" NavigationUIVisibility="Hidden" Background="Transparent"/>
                    </TabItem>
                    <TabItem Header="{DynamicResource item224}" Style="{StaticResource SettingsTabItemStyle}">
                        <Frame Source="..\SettingsPages\AssetPacks.xaml" NavigationUIVisibility="Hidden" Background="Transparent"/>
                    </TabItem>
                    <TabItem Header="{DynamicResource item196}" Style="{StaticResource SettingsTabItemStyle}">
                        <Frame Source="..\SettingsPages\AccountKey.xaml" NavigationUIVisibility="Hidden" Background="Transparent"/>
                    </TabItem>
                    <TabItem Header="{DynamicResource itemVoice}" Style="{StaticResource SettingsTabItemStyle}">
                        <Frame Source="..\SettingsPages\Voice.xaml" NavigationUIVisibility="Hidden" Background="Transparent"/>
                    </TabItem>
                    <TabItem Header="{DynamicResource item197}" Style="{StaticResource SettingsTabItemStyle}">
                        <Frame Source="..\SettingsPages\Options.xaml" NavigationUIVisibility="Hidden" Background="Transparent"/>
                    </TabItem>
                    <TabItem Header="{DynamicResource item199}" Style="{StaticResource SettingsTabItemStyle}">
                        <Frame Source="..\SettingsPages\About.xaml" NavigationUIVisibility="Hidden" Background="Transparent"/>
                    </TabItem>
                </TabControl>
            </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
