<Window x:Class="H1Emu_Launcher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" UseLayoutRounding="True"
        Title="{DynamicResource item206}" x:Name="Settings"
        Width="860" Height="620" MinWidth="860" MaxWidth="860"
        MinHeight="620" MaxHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="Transparent" FontFamily="Segoe UI" FontSize="15" Foreground="#E7E9ED"
        Loaded="SettingsLoaded" ContentRendered="SettingsWindowContentRendered"
        Closing="SettingsWindowClosing">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="1" CaptionHeight="0" NonClientFrameEdges="Bottom, Left, Right"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Language\StringResources.en-EN.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SettingsTabItemStyle" TargetType="TabItem">
                <Setter Property="Foreground" Value="#858C95"/>
                <Setter Property="Background" Value="#090C10"/>
                <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="MinWidth" Value="150"/>
                <Setter Property="Height" Value="46"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabSurface" Background="{TemplateBinding Background}"
                                    BorderBrush="#343B43" BorderThickness="1"
                                    CornerRadius="8" SnapsToDevicePixels="True">
                                <Grid>
                                    <ContentPresenter ContentSource="Header"
                                                      Margin="12,0"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border x:Name="ActiveMarker" Height="3"
                                            VerticalAlignment="Bottom" Margin="9,0,9,0"
                                            Background="#ED1C2A" CornerRadius="2,2,0,0" Opacity="0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#E0E3E7"/>
                                    <Setter TargetName="TabSurface" Property="Background" Value="#10141A"/>
                                    <Setter TargetName="TabSurface" Property="BorderBrush" Value="#39414A"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter TargetName="TabSurface" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#291015" Offset="0"/>
                                                <GradientStop Color="#120C10" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="TabSurface" Property="BorderBrush" Value="#85212A"/>
                                    <Setter TargetName="ActiveMarker" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingsTabControlStyle" TargetType="TabControl">
                <Setter Property="Background" Value="#05070A"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid Background="{TemplateBinding Background}" ClipToBounds="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <UniformGrid Grid.Row="0" IsItemsHost="True"
                                             Rows="1" Columns="5"
                                             Margin="0,6,10,10" Panel.ZIndex="2"
                                             Background="Transparent"
                                             KeyboardNavigation.TabIndex="1"/>
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  Grid.Row="1" Panel.ZIndex="1"
                                                  ContentSource="SelectedContent"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  SnapsToDevicePixels="True"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingsCloseButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#A90C12"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#D71B25"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D71923"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#080B0F" BorderBrush="#343A41" BorderThickness="1"
            CornerRadius="14" ClipToBounds="True"
            MouseLeftButtonDown="MoveSettingsWindow">
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#10151D" Offset="0"/>
                    <GradientStop Color="#090C11" Offset="0.64"/>
                    <GradientStop Color="#0D0A0D" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="26,18,0,0" VerticalAlignment="Top">
                    <TextBlock FontSize="29" FontWeight="Bold" FontFamily="Segoe UI Semibold">
                        <Run Text="JSE" Foreground="#ED1C2A"/><Run Text="mu.eu" Foreground="#F2F3F5"/>
                    </TextBlock>
                    <TextBlock Margin="2,2,0,0" Text="LAUNCHER SETTINGS" Foreground="#747C85"
                               FontSize="10" FontWeight="SemiBold"/>
                </StackPanel>
                <Button x:Name="ExitButton" Grid.Column="1" Click="CloseSettingsWindow"
                        Width="46" Height="38" Margin="0,18,18,0" VerticalAlignment="Top"
                        Style="{StaticResource SettingsCloseButtonStyle}">
                    <Path Data="{DynamicResource XIcon}" Stretch="Uniform" Fill="White" Width="12" Height="12"/>
                </Button>
                <Rectangle Height="1" Fill="#252B31" VerticalAlignment="Bottom"/>
            </Grid>

            <Border Grid.Row="1" Margin="22,0,22,22" Background="#05070A"
                    BorderBrush="#2D333A" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <TabControl x:Name="settingsTabControl" Background="#05070A" BorderThickness="0"
                            Style="{StaticResource SettingsTabControlStyle}"
                            Padding="0" Margin="5,2,5,5" SelectionChanged="SettingsTabControlSelectionChanged">
                    <TabItem Header="{DynamicResource item195}" Style="{StaticResource SettingsTabItemStyle}">
                        <Frame Source="..\SettingsPages\GameFiles.xaml" NavigationUIVisibility="Hidden" Background="Transparent"/>
                    </TabItem>
                    <TabItem Header="{DynamicResource item224}" Style="{StaticResource SettingsTabItemStyle}">
                        <Frame Source="..\SettingsPages\AssetPacks.xaml" NavigationUIVisibility="Hidden" Background="Transparent"/>
                    </TabItem>
                    <TabItem Header="{DynamicResource item196}" Style="{StaticResource SettingsTabItemStyle}">
                        <Frame Source="..\SettingsPages\AccountKey.xaml" NavigationUIVisibility="Hidden" Background="Transparent"/>
                    </TabItem>
                    <TabItem Header="{DynamicResource item197}" Style="{StaticResource SettingsTabItemStyle}">
                        <Frame Source="..\SettingsPages\Options.xaml" NavigationUIVisibility="Hidden" Background="Transparent"/>
                    </TabItem>
                    <TabItem Header="{DynamicResource item199}" Style="{StaticResource SettingsTabItemStyle}">
                        <Frame Source="..\SettingsPages\About.xaml" NavigationUIVisibility="Hidden" Background="Transparent"/>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Border>
</Window>
