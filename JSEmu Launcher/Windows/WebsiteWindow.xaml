<Window x:Class="H1Emu_Launcher.WebsiteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        Background="#080B0E"
        UseLayoutRounding="True"
        FontFamily="Bahnschrift Light"
        Foreground="#DDE3E8"
        Loaded="WindowLoaded"
        Closed="WindowClosed">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="HubButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DDE3E8"/>
            <Setter Property="Background" Value="#151A20"/>
            <Setter Property="BorderBrush" Value="#2C3540"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#E11D2A"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#252B30" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- top bar -->
            <Grid Grid.Row="0" Background="#0B0F13" MouseLeftButtonDown="DragWindow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"><Run Text="JSEMU "/><Run Text="HUB" Foreground="#E11D2A"/></TextBlock>
                    <Button Content="Gambling" Tag="/gambling" Click="NavClick" Height="34" Margin="0,0,8,0" Style="{StaticResource HubButton}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="Scrap Yard" Tag="/scrapyard" Click="NavClick" Height="34" Margin="0,0,8,0" Style="{StaticResource HubButton}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="Store" Tag="/store" Click="NavClick" Height="34" Margin="0,0,8,0" Style="{StaticResource HubButton}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="Battle Pass" Tag="/battlepass" Click="NavClick" Height="34" Margin="0,0,8,0" Style="{StaticResource HubButton}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="Pimp My Car" Tag="/pimpmycar" Click="NavClick" Height="34" Margin="0,0,8,0" Style="{StaticResource HubButton}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="Donate" Tag="/donate" Click="NavClick" Height="34" Style="{StaticResource HubButton}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>

                <TextBlock x:Name="statusText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                           Foreground="#6C7784" FontSize="12" TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Button x:Name="backButton" Content="Back" Click="BackClick" Height="34" Margin="0,0,8,0" Style="{StaticResource HubButton}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="Reload" Click="ReloadClick" Height="34" Margin="0,0,8,0" Style="{StaticResource HubButton}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="Open in browser" Click="OpenBrowserClick" Height="34" Margin="0,0,8,0" Style="{StaticResource HubButton}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Width="40" Height="34" Click="CloseClick" Style="{StaticResource HubButton}" Padding="0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close">
                        <TextBlock Text="X" FontSize="14" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- website -->
            <Grid Grid.Row="1" Background="#080B0E">
                <wv2:WebView2 x:Name="web"/>
                <TextBlock x:Name="loadingText" Text="Loading JSEmu.eu..." FontSize="17" Foreground="#8A96A3"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>
