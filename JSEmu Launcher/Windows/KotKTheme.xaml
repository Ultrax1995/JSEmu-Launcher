<!-- King of the Kill look shared by the KOTK layout of the launcher window, the KOTK hub and the
     message window: near-black surfaces, KOTK crown gold, red for cancel / danger, condensed caps. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="KotK.GoldColor">#F2B233</Color>
    <Color x:Key="KotK.GoldDarkColor">#C98A12</Color>
    <SolidColorBrush x:Key="KotK.Bg" Color="#0B0B0D"/>
    <SolidColorBrush x:Key="KotK.Surface" Color="#141416"/>
    <SolidColorBrush x:Key="KotK.SurfaceGlass" Color="#E00D0D0F"/>
    <SolidColorBrush x:Key="KotK.FieldBg" Color="#0F0F11"/>
    <SolidColorBrush x:Key="KotK.Border" Color="#2B2823"/>
    <SolidColorBrush x:Key="KotK.BorderStrong" Color="#4A3F2A"/>
    <SolidColorBrush x:Key="KotK.Gold" Color="#F2B233"/>
    <SolidColorBrush x:Key="KotK.GoldDark" Color="#E0A21B"/>
    <SolidColorBrush x:Key="KotK.GoldSoft" Color="#26F2B233"/>
    <SolidColorBrush x:Key="KotK.Red" Color="#D8352C"/>
    <SolidColorBrush x:Key="KotK.Text" Color="#EEEAE2"/>
    <SolidColorBrush x:Key="KotK.Muted" Color="#8E877B"/>
    <SolidColorBrush x:Key="KotK.Dim" Color="#5E594F"/>
    <SolidColorBrush x:Key="KotK.Online" Color="#5BC44F"/>
    <LinearGradientBrush x:Key="KotK.GoldGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFC94A" Offset="0"/>
        <GradientStop Color="#F2B233" Offset="0.45"/>
        <GradientStop Color="#D4940F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KotK.GoldLine" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00F2B233" Offset="0"/>
        <GradientStop Color="#CCF2B233" Offset="0.5"/>
        <GradientStop Color="#00F2B233" Offset="1"/>
    </LinearGradientBrush>

    <FontFamily x:Key="KotK.Display">Bahnschrift SemiBold Condensed</FontFamily>
    <FontFamily x:Key="KotK.DisplayBold">Bahnschrift Bold Condensed</FontFamily>
    <FontFamily x:Key="KotK.Body">Bahnschrift</FontFamily>

    <!-- KOTK crown -->
    <PathGeometry x:Key="KotK.CrownIcon" Figures="M1.5,8 L6.5,12.5 L12,3 L17.5,12.5 L22.5,8 L20.5,19 L3.5,19 Z M3.5,20.5 L20.5,20.5 L20.5,23 L3.5,23 Z"/>
    <PathGeometry x:Key="KotK.PersonIcon" Figures="M12,12 A4.5,4.5 0 1 0 12,3 A4.5,4.5 0 1 0 12,12 Z M3,21 C3,16.5 7,14 12,14 C17,14 21,16.5 21,21 Z"/>
    <PathGeometry x:Key="KotK.TrophyIcon" Figures="M6,3 L18,3 L18,8 C18,11.5 15.5,14 12,14 C8.5,14 6,11.5 6,8 Z M6,5 L3,5 C3,8.5 4.5,10 6.5,10.5 M18,5 L21,5 C21,8.5 19.5,10 17.5,10.5 M12,14 L12,18 M8,21 L16,21 L15,18 L9,18 Z"/>
    <PathGeometry x:Key="KotK.ChatIcon" Figures="M3,5 C3,3.9 3.9,3 5,3 L19,3 C20.1,3 21,3.9 21,5 L21,15 C21,16.1 20.1,17 19,17 L9,17 L4,21 L4,17 C3.4,17 3,16.6 3,16 Z"/>

    <!-- Plain dark button with a gold edge on hover -->
    <Style x:Key="KotK.Button" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource KotK.Text}"/>
        <Setter Property="Background" Value="#17171A"/>
        <Setter Property="BorderBrush" Value="{StaticResource KotK.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource KotK.Display}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#F2B233"/>
                            <Setter TargetName="Bd" Property="Background" Value="#211D14"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.38"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filled gold call to action -->
    <Style x:Key="KotK.GoldButton" TargetType="Button" BasedOn="{StaticResource KotK.Button}">
        <Setter Property="Foreground" Value="#1A1305"/>
        <Setter Property="Background" Value="{StaticResource KotK.GoldGradient}"/>
        <Setter Property="BorderBrush" Value="#FFD36A"/>
        <Setter Property="FontFamily" Value="{StaticResource KotK.DisplayBold}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Hover" CornerRadius="3" Background="#28FFFFFF" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#3A3322"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#4A4030"/>
                            <Setter Property="Foreground" Value="#9A8E70"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Red outline: cancel, leave, remove, decline -->
    <Style x:Key="KotK.DangerButton" TargetType="Button" BasedOn="{StaticResource KotK.Button}">
        <Setter Property="Foreground" Value="#F0A39E"/>
        <Setter Property="Background" Value="#1C1111"/>
        <Setter Property="BorderBrush" Value="#6A2420"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#D8352C"/>
                            <Setter TargetName="Bd" Property="Background" Value="#2C1413"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.38"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tab: the underline is the BorderBrush; the active tab gets gold from code (KotKSocial.MarkTab). -->
    <Style x:Key="KotK.TabButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource KotK.Muted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource KotK.Display}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{TemplateBinding BorderBrush}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#EEEAE2"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented choice (SOLO / DUOS / FIVES): the active one is marked from code (KotKSocial.MarkChoice). -->
    <Style x:Key="KotK.ChipButton" TargetType="Button" BasedOn="{StaticResource KotK.Button}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <Style x:Key="KotK.Field" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource KotK.FieldBg}"/>
        <Setter Property="Foreground" Value="{StaticResource KotK.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KotK.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="#F2B233"/>
        <Setter Property="SelectionBrush" Value="#F2B233"/>
        <Setter Property="FontFamily" Value="{StaticResource KotK.Body}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#F2B233"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#6A5A38"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Drop-down (voice devices) -->
    <Style x:Key="KotK.ComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource KotK.Text}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0" Padding="10,7">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="#16FFFFFF"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#22F2B233"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#F2B233"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KotK.ComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource KotK.Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource KotK.Body}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource KotK.ComboItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="#0F0F11" BorderBrush="#4A3F2A" BorderThickness="1" CornerRadius="3">
                                        <Path Data="M0,0 L5,5 L10,0" Stroke="#F2B233" StrokeThickness="1.6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#F2B233"/></Trigger>
                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#F2B233"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="12,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280" Margin="0,4,0,0"
                                    Background="#141416" BorderBrush="#4A3F2A" BorderThickness="1" CornerRadius="3">
                                <ScrollViewer Style="{DynamicResource CustomScrollViewer}">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lists: no system blue selection, gold bar on the selected row -->
    <Style x:Key="KotK.ListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource KotK.Text}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0" Margin="0,0,0,2">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#16FFFFFF"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#22F2B233"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#F2B233"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KotK.List" TargetType="ListBox">
        <Setter Property="Background" Value="#990B0B0D"/>
        <Setter Property="BorderBrush" Value="{StaticResource KotK.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource KotK.Text}"/>
        <Setter Property="Padding" Value="0,4"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource KotK.ListItem}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ScrollViewer Focusable="False" Style="{DynamicResource CustomScrollViewer}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin gold progress bar -->
    <Style x:Key="KotK.Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Background" Value="#26FFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource KotK.GoldGradient}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <!-- Rectangles, not rounded Borders: a rounded Border narrower than its radius (0 %) draws garbage. -->
                    <Grid>
                        <Rectangle x:Name="PART_Track" Fill="{TemplateBinding Background}" RadiusX="3" RadiusY="3"/>
                        <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}" RadiusX="3" RadiusY="3"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KotK.Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource KotK.Display}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource KotK.Muted}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="KotK.CheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource KotK.Text}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="3" BorderThickness="1" BorderBrush="#4A3F2A" Background="#0F0F11" VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="M3,9 L7,13 L15,4" Stroke="#1A1305" StrokeThickness="2.2" Visibility="Collapsed" Stretch="None" Margin="0,0,0,0"/>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#F2B233"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="#FFD36A"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#F2B233"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Friend / party member / invitation row: avatar, name, detail, status dot -->
    <DataTemplate x:Key="KotK.PersonRow">
        <Grid Margin="8,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="3" Background="#1D1A14" BorderBrush="#3A3222" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource KotK.DisplayBold}" FontSize="17" Foreground="#F2B233"/>
                    <Image Source="{Binding Avatar}" Stretch="UniformToFill"/>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource KotK.Display}" FontSize="16" Foreground="#EEEAE2" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource KotK.Body}" FontSize="11" Foreground="#8E877B" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Ellipse Grid.Column="2" Width="9" Height="9" Fill="{Binding Dot}" VerticalAlignment="Center" Margin="8,0,6,0"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
