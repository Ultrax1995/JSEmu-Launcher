<Page x:Class="H1Emu_Launcher.SettingsPages.Voice"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      UseLayoutRounding="True"
      d:DesignWidth="735"
      Title="Voice"
      FontFamily="Segoe UI"
      FontSize="16"
      Foreground="FloralWhite"
      Loaded="VoiceLoaded"
      Unloaded="VoiceUnloaded">

    <Border Background="#06090D" UseLayoutRounding="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="20,10,20,10">
                <Grid.Background>
                    <ImageBrush ImageSource="..\Resources\Grain.png" Opacity="0.12" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,512,512"/>
                </Grid.Background>
                <StackPanel>
                    <TextBlock Text="Proximity voice (JSEmu servers, 2016)" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,6" Style="{DynamicResource TextBlockStyle}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource MutedTextColour}" Margin="0,0,0,8"
                               Text="Players within about 40 m hear you while you hold push-to-talk. The launcher connects when you play on a JSEmu server and must stay open (it can be in the tray). In game, /voice shows whether you are connected."/>

                    <TextBlock x:Name="statusText" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource SuccessColour}" Margin="0,0,0,2"/>
                    <TextBlock x:Name="talkingText" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource MutedTextColour}" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="auto"/></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Enable proximity voice" Style="{DynamicResource TextBlockStyle}"/>
                        <ToggleButton x:Name="enabledToggle" Grid.Column="1" Height="20" Style="{StaticResource ToggleButtonStyle}"/>
                    </Grid>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="auto"/></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Style="{DynamicResource TextBlockStyle}"
                                   Text="Show who is talking over the game (windowed / borderless)"/>
                        <ToggleButton x:Name="indicatorToggle" Grid.Column="1" Height="20" Style="{StaticResource ToggleButtonStyle}"/>
                    </Grid>

                    <TextBlock Text="Microphone" FontSize="14" Margin="0,0,0,4" Style="{DynamicResource TextBlockStyle}"/>
                    <ComboBox x:Name="inputBox" Height="30" Margin="0,0,0,12" Padding="10,2,10,0" VerticalContentAlignment="Center"
                              BorderThickness="2" Foreground="White" FontSize="14" Style="{DynamicResource ComboBoxStyle}"
                              ItemContainerStyle="{DynamicResource ComboBoxItemStyle}"/>
                    <TextBlock Text="Speakers / headphones" FontSize="14" Margin="0,0,0,4" Style="{DynamicResource TextBlockStyle}"/>
                    <ComboBox x:Name="outputBox" Height="30" Margin="0,0,0,12" Padding="10,2,10,0" VerticalContentAlignment="Center"
                              BorderThickness="2" Foreground="White" FontSize="14" Style="{DynamicResource ComboBoxStyle}"
                              ItemContainerStyle="{DynamicResource ComboBoxItemStyle}"/>

                    <TextBlock Text="Push-to-talk override (optional, e.g. V, KP_4, Mouse_4 or Alt+V)" FontSize="14" Margin="0,0,0,4" Style="{DynamicResource TextBlockStyle}"/>
                    <TextBox x:Name="keyBox" Height="32" Margin="0,0,0,4" Padding="8,0" VerticalContentAlignment="Center" FontSize="14" Style="{DynamicResource TextBoxStyle}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextColour}" Margin="0,0,0,12"
                               Text="Empty: the game's own Proximity voice key (default numpad 4 / middle mouse). Alt+M mutes voice, numpad + / - change the volume."/>

                    <TextBlock x:Name="volumeLabel" Text="Voice volume" FontSize="14" Margin="0,0,0,4" Style="{DynamicResource TextBlockStyle}"/>
                    <Slider x:Name="volumeSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,16" ValueChanged="VolumeChanged"/>

                    <Button Content="Save" Width="140" Height="36" HorizontalAlignment="Left" Click="SaveClick" Style="{DynamicResource PrimaryButton}" Margin="0,0,0,10"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</Page>
