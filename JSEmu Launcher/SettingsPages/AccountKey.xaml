<Page x:Class="H1Emu_Launcher.SettingsPages.AccountKey"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:H1Emu_Launcher.SettingsPages"
      mc:Ignorable="d"
      UseLayoutRounding="True"
      d:DesignWidth="735"
      Title="Account Key"
      FontFamily="Segoe UI"
      FontSize="16"
      Foreground="FloralWhite"
      Loaded="AccountKeyLoaded">

    <Page.Resources>
        <ResourceDictionary>

            <!-- Load dictionary into xaml resources just so we can see on the designer -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Language\StringResources.en-EN.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Border Background="#06090D"
            UseLayoutRounding="True"
            CornerRadius="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>

            <!-- Grainy texture -->
            <Grid.Background>
                <ImageBrush ImageSource="..\Resources\Grain.png" Opacity="0.12" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,512,512"/>
            </Grid.Background>

            <!-- Info about account key message -->
            <TextBlock Grid.Row="1"
                       Margin="20"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="FloralWhite"
                       TextWrapping="Wrap"
                       Text="{DynamicResource item156}"
                       Style="{DynamicResource TextBlockStyle}"/>

            <!-- Discord account-link button -->
            <Button Grid.Row="2" Click="DiscordInviteLinkClick"
                    Width="220" Height="48" Margin="20,0,20,20"
                    HorizontalAlignment="Center" Cursor="Hand"
                    Background="#111522" BorderBrush="#3B435C" BorderThickness="1"
                    Foreground="White" ToolTip="Join the JSEmu Discord">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DiscordButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="13,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" HorizontalAlignment="Left"
                                        Background="#5865F2" CornerRadius="8">
                                    <Viewbox Width="18" Height="14" Stretch="Uniform">
                                        <Canvas Width="24" Height="18">
                                            <Path Data="M3,6 C5,2.5 19,2.5 21,6 L23,13 C23.8,15.8 20,17.5 18,14.7 L16.5,12.8 C13.5,13.8 10.5,13.8 7.5,12.8 L6,14.7 C4,17.5 0.2,15.8 1,13 Z" Fill="White"/>
                                            <Ellipse Canvas.Left="7" Canvas.Top="7.7" Width="3" Height="3" Fill="#5865F2"/>
                                            <Ellipse Canvas.Left="14" Canvas.Top="7.7" Width="3" Height="3" Fill="#5865F2"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="JOIN DISCORD" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Link your JSEmu account" FontSize="10.5" Foreground="#AEB4D7"/>
                                </StackPanel>
                                <Path Grid.Column="2" Data="{DynamicResource RightArrowIcon}"
                                      Fill="#7C87FF" Width="6" Height="12" Stretch="Fill"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DiscordButtonSurface" Property="Background" Value="#171A2A"/>
                                <Setter TargetName="DiscordButtonSurface" Property="BorderBrush" Value="#5865F2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DiscordButtonSurface" Property="Background" Value="#202442"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Button.ContextMenu>
                    <ContextMenu Style="{DynamicResource ContextMenuStyle}">
                        <MenuItem Click="DiscordInviteLinkCopy"
                                  Header="{DynamicResource item193}"
                                  Style="{DynamicResource CustomMenuItem}">
                            
                            <MenuItem.Icon>
                                <Path Data="{DynamicResource CopyIcon}"
                                      Fill="{Binding RelativeSource={RelativeSource Mode=Self}, Path=(TextElement.Foreground)}"
                                      Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <!-- Divider -->
            <Rectangle Grid.Row="3"
                       Margin="20,0,20,0"
                       Height="1"
                       Fill="{DynamicResource LighterColour}">

                <Rectangle.Effect>
                    <DropShadowEffect BlurRadius="8"
                                      Direction="-90"
                                      RenderingBias="Quality"
                                      ShadowDepth="1"
                                      Opacity="0.3"/>
                </Rectangle.Effect>
            </Rectangle>

            <Grid Grid.Row="4">

                <!-- Plain text box that holds account key for visibility toggle -->
                <TextBox x:Name="accountKeyBoxText"
                         TextChanged="AccountKeyBoxTextTextChanged"
                         Height="35"
                         Margin="20"
                         Padding="35,0,40,0"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Visibility="Hidden"
                         GotFocus="AccountKeyBoxGotFocus"
                         LostFocus="AccountKeyBoxLostFocus"
                         Style="{DynamicResource TextBoxStyle}">

                    <TextBox.Effect>

                        <!-- Drop shadow effect -->
                        <DropShadowEffect BlurRadius="15"
                                          Direction="-90"
                                          RenderingBias="Quality"
                                          ShadowDepth="1"
                                          Opacity="0.3"/>
                    </TextBox.Effect>
                </TextBox>

                <!-- Password box to hold account key -->
                <PasswordBox x:Name="accountKeyBoxPassword"
                             PasswordChanged="AccountKeyBoxPasswordPasswordChanged"
                             Height="35"
                             Margin="20"
                             Padding="35,0,40,0"
                             PasswordChar="●"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             GotFocus="AccountKeyBoxGotFocus"
                             LostFocus="AccountKeyBoxLostFocus"
                             Style="{DynamicResource PasswordBoxStyle}">

                    <PasswordBox.Effect>

                        <!-- Drop shadow effect -->
                        <DropShadowEffect BlurRadius="15"
                                          Direction="-90"
                                          RenderingBias="Quality"
                                          ShadowDepth="1"
                                          Opacity="0.3"/>
                    </PasswordBox.Effect>
                </PasswordBox>

                <!-- Hint for account key textbox -->
                <TextBlock x:Name="accountKeyBoxHint"
                           Height="27"
                           Margin="20,0,20,0"
                           Padding="40,4,40,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Foreground="Gray"
                           Text="{DynamicResource item154}"
                           Style="{DynamicResource TextBlockStyle}"/>

                <!-- Password visibility show button -->
                <Button x:Name="toggleKeyVisibilityButton"
                        Click="ToggleKeyVisibility"
                        Width="20"
                        Height="20"
                        Margin="0,0,32,0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        RenderOptions.BitmapScalingMode="Fant"
                        Style="{StaticResource PathButton}">

                    <Button.Content>
                        <Path Data="{DynamicResource EyeIcon}"
                              Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Button}}"/>
                    </Button.Content>
                </Button>

                <!-- Key image inside of account key textbox -->
                <Path Data="{DynamicResource KeyIcon}"
                      Stretch="Uniform"
                      Fill="FloralWhite"
                      Width="18"
                      Height="18"
                      Margin="30,0,0,1"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left"/>
            </Grid>

            <Border x:Name="generateAccountKeyButtonRow"
                    Grid.Row="5"
                    BorderThickness="0">

                <Grid x:Name="generateAccountKeyButtonRowContent">
                    <!-- Generate Account Key button -->
                    <Button Click="GenerateAccountKeyButtonClick"
                            Margin="20,15,20,20"
                            Padding="25,7,25,7"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Content="GENERATE"
                            Visibility="Visible"
                            Style="{DynamicResource PrimaryButton}">

                        <Button.Effect>

                            <!-- Drop shadow effect -->
                            <DropShadowEffect BlurRadius="15"
                                              Direction="-90"
                                              RenderingBias="Quality"
                                              ShadowDepth="1"
                                              Opacity="0.3"/>
                        </Button.Effect>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Page>
