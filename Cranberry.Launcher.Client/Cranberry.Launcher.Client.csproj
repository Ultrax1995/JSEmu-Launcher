<Project Sdk="Microsoft.NET.Sdk">
  <!-- Game input and proximity audio from the Cranberry launcher
       (MIT, Mixcria - see ../Cranberry.Launcher.Core/LICENSE), used by the 2016 proximity voice (Classes/Voice2016.cs). -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Cranberry.Launcher.Core/Cranberry.Launcher.Core.csproj" /></ItemGroup>
  <ItemGroup><PackageReference Include="NAudio" Version="2.2.1" /></ItemGroup>
  <ItemGroup><None Update="Notices/NAudio-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
